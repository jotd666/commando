hw_init:
	move.l	a6,a0
	add.l 	#0xC000,a0
	st.b	(system_c000-0xC000,a0)
	st.b	(port_1_c001-0xC000,a0)
	st.b	(port_2_c002-0xC000,a0)
	move.b	dip_switches_1,(dsw1_c003-0xC000,a0)
	move.b	dip_switches_2,(dsw2_c004-0xC000,a0)

	rts
	
* zero all registers
cpu_init:
	moveq	#0,d0
	moveq	#0,d1
	moveq	#0,d2
	moveq	#0,d3
	moveq	#0,d4
	moveq	#0,d5
	moveq	#0,d6
	moveq	#0,d7
	* IX/IY are on top of mem at start
	move.l	a6,a2
	add.l	#0xFFFF,a2
	move.l	a2,a3
	rts
	
	.ifndef	RELEASE
dump_and_quit:	
	jbsr	osd_dump_logs
	illegal
	.endif
force_fg_tiles_redraw:
	lea		(fg_tiles_address_d000,a6),a0
	move.w	#0x3FF,d1	
0:
	jbsr	osd_video_byte_dirty
	addq	#2,a0
	dbf		d1,0b
	rts

	


	
	
* < A0: filename
* < A1: buffer
* < D0: max size
load_file:
	move.l	_resload,d1
	jeq		0f
	move.l	d1,a2
	movem.l	d0-d3/a0/a1,-(a7)
	move.l	d0,d2		| store max size
	move.l	a0,d3		| store filename
	jbsr	resload_GetFileSizeDec(a2)
	.ifndef	RELEASE
	cmp.l	d0,d2
	jcc		0f
	BREAKPOINT	"file size too big vs buffer. D0=size, D2=max, D3=filename"
0:
	.endif
	movem.l	(a7)+,d0-d3/a0/a1
	
	jbsr	resload_LoadFileDecrunch(a2)
	rts
0:
	illegal
	
call_nmi:
	* reset most registers
	jbsr	cpu_init
	* set base for RAM
	GET_MEMORY_START_IN_A6
	
	jra	irq_02b7
	
* <D0,D1 current & prev joy states

handle_long_fire_press:
	btst 	#JPB_BTN_RED,d0
	jeq		0f
	btst	#JPB_BTN_RED,D1
	jeq		0f
	* increase timer only if
	* - button is pressed
	* - button was pressed
	* - timer is not above a given value, which is the grenade
	*   trigger value plus one (so it locks until fire is released)
	move.b	long_fire_timer,d3
	cmp.b	#LONG_FIRE_TIMER_VALUE+1,d3
	jeq		1f		| maxxed out
	addq.b	#1,d3
	move.b	d3,long_fire_timer
	cmp.b	#LONG_FIRE_TIMER_VALUE,d3
	jne		1f
	* exact value: trigger grenade
	bset	#JPB_BTN_BLU,d0
	move.l	d0,joypad_1_state
	rts
0:
	clr.b	long_fire_timer
1:
	rts
	
* just in case some hardware calls nmi
_nmi:
	move.w	#0x7FFF,_custom+intreq
	move.w	#0x7FFF,_custom+intreq
	rts
	

*****************************************************************
* interrupts
*****************************************************************

* level 3: blitter (bob chain) and vertical blank (inputs, timers)
* the blitter part is kept short: it runs ~600 times per second
level3_interrupt:
	movem.l	d0-d1/a0-a1/a5,-(a7)
	lea		_custom,a5
	move.w	(intreqr,a5),d0
	btst	#6,d0
	jeq		10f
	* blit finished: issue the next one
	move.w	#0x40,(intreq,a5)
	move.w	#0x40,(intreq,a5)		| twice (040/pistorm bug)
	tst.b	c_busy
	jeq		9f						| stray request: ignore
	jbsr	next_blit
	tst.w	d0
	jne		9f
	sf.b	c_busy					| nothing left for now (starved or finished)
9:
	movem.l	(a7)+,d0-d1/a0-a1/a5
	rte
10:
	btst	#5,d0
	movem.l	(a7)+,d0-d1/a0-a1/a5	| movem to registers leaves the flags alone
	jne		level3_vbl
	rte

level3_vbl:
	movem.l d0-d7/a0-a6,-(a7)
	lea		_custom,a5
	tst.b	detect_controllers
	jeq	0f
	clr.b	detect_controllers
	jbsr	 _detect_controller_types_nowait

0:
	move.w	main_bgm_timer,d0
	jeq		0f
	subq.w	#1,d0
	move.w	d0,main_bgm_timer
	jne		0f
	* countdown at zero
	clr.w	tune_index_times_8		| else it would reset the timer
	move.w	#LAST_LEVEL_TUNE_SND,d0
	jbsr	osd_sound_start
0:

	move.w	end_level_timer,d0
	jeq		0f
	subq.w	#1,d0
	move.w	d0,end_level_timer
	jne		0f
	* stop the end level tune before it starts the second part
	jbsr	osd_music_stop
0:

	move.l	joypad_1_state(pc),d1
	moveq	#1,d0
	jbsr	_read_joystick
	move.l	d0,joypad_1_state
	tst.b	disable_long_fire_press_flag
	jne		0f
	jbsr	handle_long_fire_press
0:	
	GET_MEMORY_START_IN_A6
	move.l	d1,d2		| save prev state
	jbsr	update_controls

	jbsr	read_system
	
	move.l	joypad_1_state,d0
	btst	#JPB_BTN_PLAY,d0
	beq.b	0f
	btst	#JPB_BTN_PLAY,d2
	bne.b	0f
	jbsr		toggle_pause
0:

	
	* ack vbl twice (040/pistorm bug)
	move.w	#0x20,(intreq,a5)
	move.w	#0x20,(intreq,a5)	
    movem.l (a7)+,d0-d7/a0-a6
    rte

* level 1: software interrupt triggered by the copper
* - bottom of the screen: VBL (game irq + rendering)
* - middle of the screen, 1 out of 5: extra game irq (60Hz game on 50Hz display)
level1_interrupt:
 	.ifndef	RELEASE
	move.l	(2,a7),interrupted_code_pc
	.endif
	addq.b	#1,osd_entry_count
    movem.l d0-d7/a0-a6,-(a7)
	lea		_custom,a5
	move.w	(intreqr,a5),d0		| needed below
	.rept	2
	move.w	#0x14,(intreq,a5)	| ack copper & soft (twice: 040/pistorm bug)
	.endr

	tst.b	pause_flag
	jne		99f

	btst	#4,d0
	jeq		2f
	* mid-screen
	move.b	mid_screen_interrupt_count,d0
	addq.b	#1,d0
	cmp.b	#5,d0
	jne		1f
	jbsr	call_nmi
	clr.b	d0
1:
	move.b	d0,mid_screen_interrupt_count
	jra		99f
2:
	* vertical blank (bottom of screen)
	jbsr	call_nmi

	GET_MEMORY_START_IN_A6
	move.w	(background_scroll_x_lsb_c80a,a6),d0
	ror.w	#8,d0		| hardware is in little endian
	move.w	D0,game_scroll_x
	move.w	(background_scroll_y_lsb_c808,a6),d0
	ror.w	#8,d0		| hardware is in little endian
	add.w	#0x100,d0	| 0: bottom part
	and.w	#0x1FF,d0
	neg.w	d0
	add.w	#0x1FF,d0
	move.w	D0,game_scroll_y

	addq.w	#1,r_vbl_count
	addq.w	#1,r_vbls_since_build
	jbsr	render_vbl

	.ifne	OPT_ENABLE_LOGGING
	jbsr	log_used_fg_tiles
	jbsr	log_used_bg_tiles
	jbsr	log_used_sprites
	.endif
99:
    movem.l (a7)+,d0-d7/a0-a6
    subq.b	#1,osd_entry_count
 	.ifndef	RELEASE
	move.l	d0,-(a7)
	move.l	(6,a7),d0
	cmp.l	interrupted_code_pc,d0
	jeq		4f
	BREAKPOINT	"interrupt PC value changed!"
4:
	move.l	(a7)+,d0
	.endif
    rte

* game events run with these off (see mainloop_8000). The blitter
* interrupt stays enabled: bobs keep being drawn while the game thinks
osd_enable_interrupts:
	move.w	#0xC06C,_custom+intena		| soft, ports, vblank, blitter
	rts
osd_disable_interrupts:
	move.w	#0x0024,_custom+intena		| soft & vblank only
	rts

*****************************************************************
* frame scheduling
*
* state machine, run at each VBL:
* - a frame is "complete" when its job list is closed (c_list_done)
*   and the blitter chain has processed everything (c_busy clear)
* - a complete frame is shown at the first VBL after completion
* - a new frame is started when the previous one is complete, enough
*   VBLs have elapsed (1: 50Hz, 2: 25Hz) and the buffer we're about to
*   draw into is no longer on screen. If the chain is late, the frame
*   is simply started at the next VBL: nothing ever waits for the blitter
*****************************************************************

* < A5: custom
render_vbl:
	tst.b	c_list_done
	jeq		99f
	tst.b	c_busy
	jne		99f
	* last frame complete
	tst.b	r_shown
	jne		1f
	jbsr	show_built_buffer
	move.w	r_vbl_count,r_shown_vbl
	st.b	r_shown
1:
	* blitter idle: CPU can safely draw queued background tiles
	jbsr	drain_bg_tile_queue
	lea		_custom,a5
	move.w	r_vbls_since_build,d0
	cmp.w	r_min_interval,d0
	jcs		99f
	* the buffer we're going to draw into is the one displayed until now
	move.w	r_shown_vbl,d0
	cmp.w	r_vbl_count,d0
	jne		2f				| swapped at an earlier VBL: copper uses the new one
	* swapped just now: OK only if the copper hasn't fetched this frame's
	* bitplane pointers yet (we're in the vertical blank)
	move.l	(vposr,a5),d0
	lsr.l	#8,d0
	and.w	#0x1FF,d0
	cmp.w	r_late_start,d0
	jcs		2f
	cmp.w	r_late_end,d0
	jcs		99f				| too late: start at next VBL
2:
	jbsr	start_new_frame
99:
	rts

* points the copper to the last completed buffer, with the scrolling
* value that was used to draw its bobs
show_built_buffer:
	lea		r_buffers,a0
	tst.w	r_built
	jeq		0f
	lea		(BUF_SIZEOF,a0),a0
0:
	move.l	(BUF_BASE,a0),d0
	moveq	#0,d1
	move.w	(BUF_SCROLL+2,a0),d1		| scroll Y
	add.w	d1,d1
	add.w	d1,d1
	lea		mulLBG_ROW_STRIDE_table,a1
	add.l	(a1,d1.l),d0
	lea		bobs_bitplanes+2,a1
	moveq	#NB_PLAYFIELD_PLANES-1,d1
1:
	swap	d0
	move.w	d0,(a1)
	swap	d0
	move.w	d0,(4,a1)
	addq.w	#8,a1
	add.l	#BG_NB_BYTES_PER_ROW,d0		| interleaved: next plane is the next 32 bytes
	dbf		d1,1b
	rts

* < A5: custom. Blitter is idle
start_new_frame:
	clr.w	r_vbls_since_build
	sf.b	c_list_done
	sf.b	r_shown
	* draw into the other buffer
	eor.w	#1,r_built
	lea		r_buffers,a4
	jeq		0f
	lea		(BUF_SIZEOF,a4),a4
0:
	* mirror cache: flush when half full. Safe now: nothing references it
	move.l	r_mpool_ptr,d0
	sub.l	#mirror_pool,d0
	cmp.l	#MIRROR_POOL_FLUSH,d0
	jcs		1f
	move.l	#mirror_pool,r_mpool_ptr
	clr.w	r_mslot_count
1:
	.ifndef	RELEASE
	move.l	r_mpool_ptr,r_mpool_frame_start
	.endif
	* chain state
	move.l	(BUF_BASE,a4),c_dest_base
	jbsr	mark_static_erases
	move.l	(BUF_ERASE_CUR,a4),a0
	move.l	a0,c_erase_ptr
	move.w	(BUF_ERASE_COUNT,a4),d0
	mulu	#ER_SIZEOF,d0
	add.l	d0,a0
	move.l	a0,c_erase_end
	lea		r_jobs,a0
	move.l	a0,c_job_ptr
	move.l	a0,c_job_end
	clr.w	c_plane
	* blitter setup for the erase phase (jobs set their own registers)
	move.l	#0x09F00000,(bltcon0,a5)	| A->D copy
	move.l	#-1,(bltafwm,a5)
	* start erasing the bobs drawn in this buffer last time...
	jbsr	kick_chain
	* ...while we build the new jobs (each new job restarts the blitter if it ran out of work)
	move.l	(BUF_ERASE_NEXT,a4),r_erase_wptr
	clr.w	r_erase_count
	jbsr	build_bob_jobs
	* what we've drawn is what we'll erase next time
	move.l	(BUF_ERASE_CUR,a4),d0
	move.l	(BUF_ERASE_NEXT,a4),(BUF_ERASE_CUR,a4)
	move.l	d0,(BUF_ERASE_NEXT,a4)
	move.w	r_erase_count,(BUF_ERASE_COUNT,a4)
	move.l	game_scroll_x,(BUF_SCROLL,a4)	| x & y
	.ifndef	RELEASE
	* 0x14C: most mirror pool bytes used by a single frame (write 0 to reset)
	move.l	r_mpool_ptr,d0
	sub.l	r_mpool_frame_start,d0
	cmp.w	0x14C,d0
	jls		0f
	move.w	d0,0x14C
0:
	.endif
	st.b	c_list_done
	rts

* static objects (palm trees...) drawn at the same place on a screen
* that didn't scroll don't need to be erased (they're redrawn anyway)
* < A4: buffer
mark_static_erases:
	move.l	(BUF_SCROLL,a4),d0
	cmp.l	game_scroll_x,d0
	jne		99f
	GET_MEMORY_START_IN_A6
	move.b	(global_y_msb_copy_e05b,a6),d0
	or.b	(global_y_lsb_copy_e05c,a6),d0
	jeq		99f				| master Y is 0 (heli arriving): no optimization
	lea		object_type_table,a1
	move.l	(BUF_ERASE_CUR,a4),a0
	move.w	(BUF_ERASE_COUNT,a4),d1
	jra		2f
1:
	move.w	(ER_CODE,a0),d0
	tst.b	(a1,d0.w)
	jeq		3f
	clr.w	(ER_SIZE,a0)
3:
	lea		(ER_SIZEOF,a0),a0
2:
	dbf		d1,1b
99:
	rts
osd_blitz:
	blitz
	rts

osd_break:
	* sends a WinUAE command to enter WinUAE debugger
	.ifndef	RELEASE
	tst.l	_resload
	jeq		1f
* wait for VBL, so when breakpoint is hit, the DMA has displayed the current picture
	move.l	D0,-(a7)
	move.l	a0,-(a7)
	move.w	SR,-(a7)
	* block interrupts during the vblank wait
	* in dev mode, we use whdload in supervisor mode so SR can be written to
	move.w	#0x2700,SR
	lea	_custom,a0
	.rept	2
	move.w	#0x7FFF,intreq(a0)
0:
	move.w	intreqr(a0),d0
	btst	#5,d0
	beq.b	0b
	.endr
	move.w	(a7)+,sr
	move.l	(a7)+,a0
1:
	pea     0.w
	* Normally it would point to where the result of the command is written, but since the last parameter (first pushed)
	* indicating the number of bytes to write is 0, nothing is written.
	pea     0.w	
	pea     1003f-1002f
	pea     1002f(pc)
	pea     -1.w
	pea     82.w
	jsr     0xf0ff60
	lea     24(sp),sp
	move.l	(a7)+,d0
	.endif
    rts
		
1002: .asciz    "AKS_ENTERDEBUGGER 1"
1003:
        .align	2

* < D0: number of 1/60Hz ticks
* can work with interrupts enabled or disabled
osd_wait:
	move.w	d0,delay_timer
	**jbsr	osd_is_vblank_interrupt_enabled
	tst.w	d0
	jne		2f
	* interrupts are disabled: timer isn't going to change
	* wait using vertical blank interrupt request (we don't need it!)
	clr.w	one_out_of_five
0:
	move.w	#0x20,_custom+intreq
	move.w	#0x20,_custom+intreq
1:
	move.w	_custom+intreqr,d0
	btst	#5,d0
	beq.b	1b
	addq.w	#1,one_out_of_five
	cmp.w	#5,one_out_of_five
	bne.b	5f
	subq.w	#1,delay_timer	
	clr.w	one_out_of_five
5:
	subq.w	#1,delay_timer
	beq.b	4f
	bpl.b	0b
4:
	rts
	
2:
	tst.w	delay_timer
	bne.b	2b
	rts

add_to_score:
	movem.l	a6/d0-d3,-(a7)
	GET_MEMORY_START_IN_A6
	move.l	a6,a0
	moveq	#0,d0
	add.l	#player_score_address_e0a6,a0
	move.w	(a0),d0
	jeq		1f
	rol.w	#8,d0
	move.l	a6,a0
	add.l	d0,a0   | current player score address
	moveq	#0,d0
	abcd 	d0,d0		| clear X

	move.b	(1,a0),d0
	move.b	(a0),d1
	move.b	#0x10,d3		| 10000 points
	abcd	d3,d0
	jcc		10f
	moveq	#0,d3
	abcd	d3,d1

10:
	move.b	d0,(1,a0)
	move.b	d1,(a0)
1:
	movem.l	(a7)+,a6/d0-d3
	rts

lose_all_lives:
	movem.l	a6/d0-d3,-(a7)
	GET_MEMORY_START_IN_A6
	add.l	#0xE000,a6
	move.b	#1,(nb_lives_eda0-0xE000,a6)
	move.b	#0x3F,(player_state_e100-0xE000,a6)
	movem.l	(a7)+,a6/d0-d3
	rts

	
* Z: set if playing
is_game_playing:
	movem.l	d0/a6,-(a7)
	GET_MEMORY_START_IN_A6
	add.l	#game_state_e001,a6
	move.b	(a6),d0
	cmp.b	#4,d0
	jeq		1f
	cmp.b	#5,d0
	jeq		1f
	cmp.b	#6,d0
	jeq		1f
	* game not playing but is grenade displayed?
	cmp.b	#0xB2,(0XD180-game_state_e001,a6)
	jeq		1f
	* grenade not displayed, check if we're in highscore entry (TIMER)
	cmp.b	#0x54,(0xD07C-game_state_e001,a6)
1:
	movem.l	(a7)+,d0/a6
	rts
store_system:
	tst.l	_resload
	beq.b	0f
	rts
0:
	* system copper
	
	move.l	4.W,a6
	move.w	AttnFlags(a6),d0
	btst	#AFB_68010,d0
	beq.b	1f
	lea	get_vbr,a5

	jsr		_LVOSupervisor(a6)
	move.l	d0,system_vbr
1:
	

	lea	_custom,a6
	move.w	intenar(a6),old_intena
	move.w	dmaconr(a6),old_dmacon
	lea		old_sysvectors,a0
	move.l	system_vbr(pc),a1
	move.l	(0x64,a1),(a0)+
	move.l	(0x68,a1),(a0)+
	move.l	(0x6c,a1),(a0)+
	move.l	(0x70,a1),(a0)+
	move.l	(0x74,a1),(a0)+
	move.l	(0x78,a1),(a0)+
	move.l	(0x7C,a1),(a0)+
	rts

restore_system:
	move.l	system_vbr(pc),a0
	lea	_custom,a6
	jsr		_mt_remove_cia

	move.w	#0x4000,intena(a6)	| ints off
	lea		old_sysvectors,a0
	move.l	system_vbr(pc),a1
	move.l	(a0)+,(0x64,a1)
	move.l	(a0)+,(0x68,a1)
	move.l	(a0)+,(0x6c,a1)
	move.l	(a0)+,(0x70,a1)
	move.l	(a0)+,(0x74,a1)
	move.l	(a0)+,(0x78,a1)
	move.l	(a0)+,(0x7C,a1)


	bclr	#6,0xbfee01


	lea	_custom,a6
	move.w	old_intena,d0			| get old val
	and.w	#0x3fff,d0
	eor.w	#0x3fff,d0
	move.w	d0,intena(a6)		| clr bits
	eor.w	#0x3fff,d0
	or.w	#0xc000,d0		
	move.w	d0,intena(a6)		| set bits and main

	move.w	old_dmacon,d0			| get old val
	and.w	#0x3fff,d0
	eor.w	#0x3fff,d0

***		and.w	#0xfff0,d0		| preserve sound dma for now

	move.w	d0,dmacon(a6)		| clr bits



	eor.w	#0x3fff,d0
	or.w	#0xc000,d0		
	move.w	d0,dmacon(a6)		| set bits and main

	move.l	old_syscoplist,cop1lc(a6)
	move.l	_gfxbase,a6
	move.b	gb_ChipRevBits0(a6),chiprevbits+3
	move.l	old_actiview,a1
	jsr	_LVOLoadView(a6)


	moveq	#0,d0
	rts
platform_init:
	bsr		store_system
	

	lea		_custom,a5
	move.w	#0x7FFF,dmacon(a5)
	move.w	#0x7FFF,intena(a5)
	move.w	#0x7FFF,intreq(a5)
	* set blitter parameters
	move.l	#-1,bltafwm(a5)
	
	
	
	move.l	monitor,d0
	cmp.l	#NTSC_MONITOR_ID,D0
	bne		0f
	st.b	ntsc_flag
	* disable extra mid-screen interrupt, as it would be too fast (NTSC)
	move.w	#COPPER_NOP,pal_intreq_block_game
	* also change screen start position, make it higher
	move.w	#0x01+(0xC<<8),screen_start

	move.w	#COPPER_NOP,pal_wait			| else intreq never happens
	move.w	#COPPER_NOP,pal_wait+4			| else intreq never happens
	move.w	#COPPER_NOP,pal_wait+8			| else intreq never happens
0:
	.if		NB_PLAYFIELD_PLANES==8
    move.w #0x0210+BORDERBLANK,bplcon0(a5) | 8 bitplanes, borderblank
	.else
    move.w #0x200+BORDERBLANK+(NB_PLAYFIELD_PLANES<<12),bplcon0(a5) | 8 > nb bitplanes, borderblank
	.endif
    move.w #BASE_BPLCON2_VALUE,bplcon2(a5)



 	*         VVHH
    move.w #0x91+((Y_START+0x10)<<8),d0
    move.w #0x71+((Y_START+0x10)<<8),d1
	cmp.l	#NTSC_MONITOR_ID,monitor
	jne		0f
	sub.w	#NTSC_Y_SHIFT<<8,d0
	sub.w	#NTSC_Y_SHIFT<<8,d1
0:	
	* AGA

	.ifne	OPT_AGA_MODE
    move.w #BASE_BPLCON4_VALUE,bplcon4(a5)
    move.w #0x0C00+BORDERBLANK<<5,bplcon3(a5)     | no AGA specificities, default ECS

	.endif
	
    move.w d0,diwstrt(a5)
    move.w d1,diwstop(a5)
    move.w #0x0038,ddfstrt(a5)

	* interleaved: modulo skips the other planes' lines
	move	#BG_ROW_STRIDE-40,d0

	.ifne	OPT_AGA_MODE
    move.w #0x00C0,ddfstop(a5)		| C0 for fmode=3
	move.w	#(3<<2)+3,fmode(a5)		| wide sprites, faster fetch
	subq	#8,d0			| change modulo
 	.else
	move.w #0x00D0,ddfstop(a5)		| C0 for fmode=3
	.endif
	
	* 0 modulo (OCS)
    move.w d0,bpl1mod(a5)
    move.w d0,bpl2mod(a5)


	
	
	lea		hw_sprite_ram_buffer,a0
	jbsr	align_for_fmode
	moveq	#7,d0
	lea		hw_sprite_pointers,a1
0:
	move.l	a0,(a1)+
	add.w	#HW_SPRITE_BUFFER_SIZE,a0
	dbf		d0,0b
	
	* screen buffers (interleaved), 8-byte aligned for fmode=3
	* with at least 2 bytes before the start (left clipping)
	lea		screen_buffer_1,a0
	addq	#2,a0
	jbsr	align_for_fmode
	move.l	a0,r_buf0
	lea		screen_buffer_2,a0
	addq	#2,a0
	jbsr	align_for_fmode
	move.l	a0,r_buf1
	lea		restore_buffer,a0
	addq	#2,a0
	jbsr	align_for_fmode
	move.l	a0,r_restore
	move.l	a0,c_restore_base

	st		music_track_start_number

	* init color table handling the bank switch issue
	lea		copperlist_colors,a0
	lea		color_copper_pointers,a1
	moveq	#(TOTAL_NB_COLORS/32),d0		| nb banks for all colors + sprite color bank (hence no minus one)
0:
	.ifne	OPT_AGA_MODE
	addq.w	#4,a0		| skip set bank
	.endif
	move.w	#31,d1		| 32 colors per bank
1:
	move.l	a0,(a1)+
	addq.w	#4,a0
	dbf		d1,1b
	dbf		d0,0b
	
	
	
	* put static sprite entries, we'll write into
	* that sprite area
	lea		game_sprites,a2
	lea		hw_sprite_pointers,a1
1:
	move.l	(a1)+,d0
	move.w	d0,(6,a2)
	swap	d0
	move.w	d0,(2,a2)
	*swap	d0
	addq	#8,a2
	cmp.l	#game_sprites_end,a2
	bcs		1b
2:
	* compute control words for each sprite pair
	lea		hw_sprite_pointers,a0
	lea		HW_SpriteYTable_256,a1
	moveq	#3,d7
	moveq	#3,d7
	moveq	#0,d2	| sprite X start
0:
	move.w	d2,d0
	move.w	#0x14,d1
	tst.b	ntsc_flag
	jeq		1f
	sub.w	#12,d1		| sprites slightly higher
1:
	jbsr	store_sprite_pos
	add.w	#64,d2		| advance X
	
	* store control word
	.rept	2
	move.l	(a0)+,a2
	move.w	d0,(8,a2)
	swap 	d0
	move.w	d0,(a2)
	swap	d0
	bset	#7,d0		| attach bit
	addq	#8,a2
	.endr
	
	dbf	d7,0b

	
	* load attached sprites palette
	lea		fg_tile_palette,a0
	move.l	color_copper_pointers+TOTAL_NB_COLORS*4,a1	| entries 64-80
	move.w	#16,d0
	jbsr	load_palette
		
	lea		bg_tile_palette,a0
	move.l	color_copper_pointers,a1	| entries 0-63
	move.w	#TOTAL_NB_COLORS,d0
	jbsr	load_palette
		
	
	
	jbsr		init_renderer
	
	
	lea		_custom,a5
	lea		game_copperlist,a0
	move.l	a0,cop1lc(a5)

	

	* wait 300 lines
	move.w	#100,d0
	bsr	beamdelay
	move.w	#100,d0
	bsr	beamdelay
	move.w	#100,d0
	bsr	beamdelay
	
    * init sprite, bitplane, whatever dma

    move.w #0x83E0,dmacon(a5)
 

	* install keyboard and vblank/copper handler
	move.l	system_vbr(pc),a1
	pea		level2_interrupt(pc)
	move.l	(a7)+,(0x68,a1)
	pea		level3_interrupt(pc)
	move.l	(a7)+,(0x6C,a1)
	pea		_nmi(pc)
	move.l	(a7)+,(0x7C,a1)

	* soundfx lib
	lea		_custom,a6
	lea		blank_sound,a0
	move.l	a0,(0xA0,a6)
	move.l	a0,(0xB0,a6)
	move.l	a0,(0xC0,a6)
	move.l	a0,(0xD0,a6)
	move.l	system_vbr(pc),a0
	moveq	#1,d0	| PAL
	jsr		_mt_install_cia


	
*	lea		hw_sprite_pointers,a0
*	move.w	#0x48,d7
*
*2:
*	move.b	#0x48,d0
*	move.b	#1,d1
*	jbsr	update_fg_tile
*	
*	addq	#1,d7
*	cmp.w	#0x400,d7
*	jne		2b
	
	
	
    rts

init_renderer:
	lea		r_buffers,a0
	move.l	r_buf0,(BUF_BASE,a0)
	clr.l	(BUF_SCROLL,a0)
	move.l	#erase_list_0a,(BUF_ERASE_CUR,a0)
	move.l	#erase_list_0b,(BUF_ERASE_NEXT,a0)
	clr.w	(BUF_ERASE_COUNT,a0)
	lea		(BUF_SIZEOF,a0),a0
	move.l	r_buf1,(BUF_BASE,a0)
	clr.l	(BUF_SCROLL,a0)
	move.l	#erase_list_1a,(BUF_ERASE_CUR,a0)
	move.l	#erase_list_1b,(BUF_ERASE_NEXT,a0)
	clr.w	(BUF_ERASE_COUNT,a0)
	* "buffer 0 has been built and shown": first frame goes to buffer 1
	clr.w	r_built
	st.b	r_shown
	st.b	c_list_done
	sf.b	c_busy
	move.l	#mirror_pool,r_mpool_ptr
	clr.w	r_mslot_count
	* 25Hz by default (frameskip set by apply_settings)
	move.w	#1,r_min_interval
	tst.b	frameskip
	jeq		0f
	move.w	#2,r_min_interval
0:
	* lines where the copper has already loaded the bitplane pointers
	* of the current frame (copper waits for line 0x20 / 0x0C in NTSC)
	move.w	#0x1C,r_late_start
	move.w	#0x12C,r_late_end
	tst.b	ntsc_flag
	jeq		1f
	move.w	#0x08,r_late_start
	move.w	#0x200,r_late_end
1:
	jbsr	show_built_buffer
	rts
* < A0: palette
* < A1: copperlist
* < D0: number of colors to load	
load_palette:
	moveq	#0,d2
	subq.w	#1,d0
	beq.b	2f
1:
	addq.w	#2,a1
	move.w	(a0)+,(a1)+
	addq	#1,d2
	cmp.b	#32,d2
	jne		3f
	moveq	#0,d2
	addq	#4,a1		| skip bank
3:
	dbf		d0,1b
2:
	rts

* Claude A.I. suggested that I freeze the sprite buffer to avoid tile/sprite delays
* ... and it worked!

osd_trigger_sprite_dma:
	movem.l	d0/a0/a1,-(a7)
	lea		(SPRITE_ADDRESS,a6),a0
	lea		buffered_spriteram,a1
	moveq	#SPRITE_BUFFER_SIZE/16-1,d0
0:
	.rept	4
	move.l	(a0)+,(a1)+
	.endr
	dbf		d0,0b
	movem.l	(a7)+,d0/a0/a1
	rts	

*****************************************************************
* video RAM writes
*****************************************************************

* hardware can scroll horizontally but game doesn't use it
* (only the MSB at the end of a level): just clear the screen
* called from a game event (blitter interrupt still running)
* < D0: 0 or 1
osd_set_x_page:
	tst.b	D0
	jeq		1f
	movem.l	d0/a0-a3,-(a7)
	jbsr	flush_bg_tile_queue
	* let the blitter finish what it's doing in the buffers
0:
	tst.b	c_busy
	jne		0b
	move.l	r_buf0,a0
	move.l	r_buf1,a1
	move.l	r_restore,a2
	move.l	#BG_BUFFER_SIZE/16-1,d0
0:
	.rept	4
	clr.l	(a0)+
	clr.l	(a1)+
	clr.l	(a2)+
	.endr
	subq.l	#1,d0
	jpl		0b
	* nothing left to erase
	lea		r_buffers,a3
	clr.w	(BUF_ERASE_COUNT,a3)
	clr.w	(BUF_SIZEOF+BUF_ERASE_COUNT,a3)
	movem.l	(a7)+,d0/a0-a3
1:
	rts

* a0=screen address (preserved)
* a6=ram base
* preserves all registers
* D000: foreground/HUD (D400: attributes), hardware sprites
* D800: background (DC00: attributes), queued
osd_video_byte_dirty:
	movem.l	d0-d7/a0-a5,-(a7)
	move.l	a0,d7
	sub.l	a6,d7
	jmi		99f
	.ifndef		RELEASE
	cmp.w	#FG_SCREEN_TILE_ADDRESS+0x1000,d7
	jcs		0f
	BREAKPOINT	"write videoram out of range (D7)"
	jra		99f
0:
	.endif
	sub.w	#FG_SCREEN_TILE_ADDRESS,d7
	.ifndef	RELEASE
	jpl		0f
	add.w	#FG_SCREEN_TILE_ADDRESS,d7
	BREAKPOINT	"write videoram out of range (D7)"
	jra		99f
0:
	.endif
	cmp.w	#BG_SCREEN_TILE_ADDRESS-FG_SCREEN_TILE_ADDRESS,d7
	jcc		10f
	* foreground (HUD)
	and.w	#0x3FF,d7
	lea		(FG_SCREEN_TILE_ADDRESS,a6),a0
	move.b	(a0,d7.w),d0
	lea		(FG_SCREEN_COLOR_ADDRESS,a6),a0
	move.b	(a0,d7.w),d1
	jbsr	update_fg_tile
	jra		99f
10:
	* background
	and.w	#0x3FF,d7
	jbsr	queue_bg_tile			| always: records the last index written to the slot
	tst.b	osd_bg_tiles_immediate
	jne		12f
	tst.w	d0
	jeq		99f					| queued: drawn by the VBL interrupt
	jra		11f					| queue full: draw now
12:
	* full screen paint: draw now (the queued copy will redraw the same tile),
	* but not while the blitter uses the buffers
	tst.b	c_busy
	jne		12b
11:
	lea		(BG_SCREEN_TILE_ADDRESS,a6),a0
	move.b	(a0,d7.w),d0
	lea		(BG_SCREEN_COLOR_ADDRESS,a6),a0
	move.b	(a0,d7.w),d1
	jbsr	update_bg_tile
99:
	movem.l	(a7)+,d0-d7/a0-a5
	rts

*****************************************************************
* deferred background tiles
*
* producer: main loop (game events) through osd_video_byte_dirty
* consumer: VBL interrupt, only when the blitter chain is idle (the CPU
* writes in the restore buffer the erase blits read from)
* - ring of tile indexes, producer writes head, consumer writes tail
* - one "pending" flag per tile: a tile is queued once, and drawn with
*   the tile RAM values of the moment it's drawn
* - urgent tiles (close to the visible window) are drawn first: drawn
*   entries become holes (-1), tail skips them
*****************************************************************

* < D7: tile index (0-0x3FF)
* > D0: 0 if queued (or already pending), non-zero if caller must draw it
* trashes: D0-D1,A0
queue_bg_tile:
	* indexes i and i^0x10 share the same screen tile (X is 4 bits, see
	* cache_bg_tiles_address): queue the screen slot, and draw the index
	* written last, like immediate drawing would ("last write wins")
	move.w	d7,d1
	and.w	#0x3EF,d1
	lea		bg_tile_last_index,a0
	add.w	d1,d1
	move.w	d7,(a0,d1.w)
	lsr.w	#1,d1
	lea		bg_tile_pending_flags,a0
	tst.b	(a0,d1.w)
	jne		1f
	move.w	bg_tile_queue_head,d0
	sub.w	bg_tile_queue_tail,d0
	and.w	#BG_TILE_QUEUE_MASK,d0
	cmp.w	#BG_TILE_QUEUE_MASK-4,d0
	jcc		2f					| (almost) full: can't happen, draw now
	st.b	(a0,d1.w)
	move.w	bg_tile_queue_head,d0
	lea		bg_tile_queue,a0
	move.w	d1,(a0,d0.w)			| screen slot
	addq.w	#2,d0
	and.w	#BG_TILE_QUEUE_MASK,d0
	move.w	d0,bg_tile_queue_head	| publish (one word write)
1:
	moveq	#0,d0
	rts
2:
	moveq	#-1,d0
	rts

* VBL interrupt, blitter idle
* trashes: everything but A5
drain_bg_tile_queue:
	move.w	bg_tile_queue_head,d7
	cmp.w	bg_tile_queue_tail,d7
	jeq		99f
	GET_MEMORY_START_IN_A6
	move.w	game_scroll_y,d4
	move.w	d4,d5
	sub.w	#BG_TILE_URGENT_MARGIN,d4			| first "hot" line (can be < 0)
	add.w	#256+BG_TILE_URGENT_MARGIN,d5		| first line after the "hot" zone
	lea		bg_tile_queue,a2
	lea		bg_tile_address_table,a3
	moveq	#BG_TILES_PER_FRAME,d1
	moveq	#BG_TILES_MAX_PER_FRAME,d3

	* pass 1: tiles close to the visible window, any order
	move.w	bg_tile_queue_tail,d2
10:
	cmp.w	d2,d7
	jeq		20f
	move.w	(a2,d2.w),d0
	jmi		12f
	move.w	d0,d6
	add.w	d6,d6
	move.w	(a3,d6.w),d6
	and.w	#0x1F,d6
	lsl.w	#4,d6					| first line of the tile
	cmp.w	d5,d6
	jge		11f
	add.w	#BG_TILE_HEIGHT,d6
	cmp.w	d4,d6
	jgt		13f
	sub.w	#BG_TILE_HEIGHT,d6
11:
	cmp.w	#0x10*BG_TILE_HEIGHT,d6	| rows < 0x10 also have a copy 512 lines below
	jge		12f
	add.w	#512,d6
	cmp.w	d5,d6
	jge		12f
	add.w	#BG_TILE_HEIGHT,d6
	cmp.w	d4,d6
	jle		12f
13:
	jbsr	draw_queued_bg_tile
	tst.w	d3
	jle		30f
12:
	addq.w	#2,d2
	and.w	#BG_TILE_QUEUE_MASK,d2
	jra		10b

	* pass 2: oldest first, within the normal budget
20:
	move.w	bg_tile_queue_tail,d2
21:
	tst.w	d1
	jle		30f
	cmp.w	d2,d7
	jeq		30f
	move.w	(a2,d2.w),d0
	jmi		22f
	jbsr	draw_queued_bg_tile
22:
	addq.w	#2,d2
	and.w	#BG_TILE_QUEUE_MASK,d2
	jra		21b

	* skip holes at the start of the ring
30:
	move.w	bg_tile_queue_tail,d2
31:
	cmp.w	d2,d7
	jeq		32f
	tst.w	(a2,d2.w)
	jpl		32f
	addq.w	#2,d2
	and.w	#BG_TILE_QUEUE_MASK,d2
	jra		31b
32:
	move.w	d2,bg_tile_queue_tail
99:
	rts

* < D0: screen slot, A2+D2: queue entry, A6: memory base
* decrements D1 & D3
draw_queued_bg_tile:
	move.w	#-1,(a2,d2.w)
	movem.l	d1-d7/a2-a3,-(a7)
	lea		bg_tile_pending_flags,a0
	clr.b	(a0,d0.w)
	lea		bg_tile_last_index,a0
	add.w	d0,d0
	move.w	(a0,d0.w),d7			| RAM index written last to that slot
	lea		(BG_SCREEN_TILE_ADDRESS,a6),a0
	move.b	(a0,d7.w),d0
	lea		(BG_SCREEN_COLOR_ADDRESS,a6),a0
	move.b	(a0,d7.w),d1
	jbsr	update_bg_tile
	movem.l	(a7)+,d1-d7/a2-a3
	subq.w	#1,d1
	subq.w	#1,d3
	rts

* drop everything pending (screen is being cleared), main loop
flush_bg_tile_queue:
	move.l	a0,-(a7)
	move.w	d0,-(a7)
	PUSH_INTERRUPT_STATE
	DISABLE_INTERRUPTS
	move.w	bg_tile_queue_head,bg_tile_queue_tail
	lea		bg_tile_pending_flags,a0
	move.w	#0x400/4-1,d0
0:
	clr.l	(a0)+
	dbf		d0,0b
	PULL_INTERRUPT_STATE
	move.w	(a7)+,d0
	move.l	(a7)+,a0
	rts

*****************************************************************
* background tiles (16x16), drawn by the CPU in the 2 screens and the
* restore buffer at once. Interleaved: plane p of line y is at
* y*192 + p*32
*****************************************************************

cache_bg_tiles_address:
	
	* cache: address => tile-accurate X,Y
	lea		bg_tile_address_table,a0
	move.w	#0,d7
0:
	move.w	d7,d0
	*and.w	#0x1F,d0
	and.w	#0xF,d0  | we merge left & right parts
	lsl.w	#8,d0
	move.w	d7,d1
	lsr.w	#5,d1
	neg.w	d1
	add.w	#0x1F,d1
	
	or.b	d1,d0
	move.w	d0,(a0)+
	addq	#1,d7
	cmp.w	#0x400,d7
	jne		0b
	
	rts

* < D7: 0-0x3FF tile index
* < D0: tile code
* < D1: attribute
* trashes: D0-D6/A0-A4
update_bg_tile:
	moveq	#0,d2
	move.b	d0,d2					| tile code
	moveq	#0,d3
	move.b	d1,d3					| CLUT, code MSBs, flip/mirror
	move.w	d3,d4
	and.w	#0xC0,d4
	add.w	d4,d4
	add.w	d4,d4
	add.w	d4,d2					| full tile code
	* buffer offset
	lea		bg_tile_address_table,a1
	move.w	d7,d0
	add.w	d0,d0
	moveq	#0,d1
	move.w	(a1,d0.w),d1			| X in MSB, buffer row (0-0x1F) in LSB
	moveq	#0,d0
	move.b	d1,d0
	lsr.w	#8,d1
	add.w	d1,d1					| byte offset in line
	cmp.w	#0x10,d0
	scs		d6						| rows 0-15 are drawn again 512 lines below
	lsl.w	#6,d0					| row * 16 lines * 4
	lea		mulLBG_ROW_STRIDE_table,a1
	add.l	(a1,d0.w),d1
	* tile planes
	lea		empty_tile_planes,a2
	cmp.w	#0xF8,d2
	jeq		2f						| blank tile
	lea		bg_character_table,a0
	add.w	d2,d2
	add.w	d2,d2
	move.l	(a0,d2.w),d0
	jeq		2f
	move.l	d0,a0
	move.w	d3,d0
	and.w	#BG_TILE_NB_CLUTS-1,d0
	add.w	d0,d0
	add.w	d0,d0
	move.l	(a0,d0.w),d0
	jeq		2f
	move.l	d0,a2					| 6 plane pointers (0: empty)
2:
	lsr.w	#4,d3
	and.w	#3,d3					| bit 0: Y flip, bit 1: X mirror
	add.w	d3,d3
	add.w	d3,d3
	lea		bg_tile_draw_table,a0
	move.l	(a0,d3.w),a0
	move.l	r_buf0,a1
	add.l	d1,a1
	move.l	r_buf1,a3
	add.l	d1,a3
	move.l	r_restore,a4
	add.l	d1,a4
	tst.b	d6
	jeq		3f
	movem.l	a0-a4,-(a7)
	jsr		(a0)
	movem.l	(a7)+,a0-a4
	move.l	#WRAP_COPY_OFFSET,d1
	add.l	d1,a1
	add.l	d1,a3
	add.l	d1,a4
3:
	jmp		(a0)

bg_tile_draw_table:
	.long	tile16_standard
	.long	tile16_flipped
	.long	tile16_mirror
	.long	tile16_mirror_flipped

	* unrolled copy of one plane (16 rows), ~230 bytes: fits in the
	* 68020 instruction cache for the 6 planes
	.macro	TILE16_PLANE_COPY	first_offset,step
	.set	tile_off,\first_offset
	.rept	BG_TILE_HEIGHT
	move.w	(a0)+,d0
	move.w	d0,(tile_off,a1)
	move.w	d0,(tile_off,a3)
	move.w	d0,(tile_off,a4)
	.set	tile_off,tile_off+\step
	.endr
	.endm

	.macro	TILE16_NEXT_SOURCE
	move.l	(a2)+,d0
	jne		1f
	move.l	#zero_tile_plane,d0
1:
	move.l	d0,a0
	.endm

	.macro	TILE16_NEXT_DEST
	lea		(BG_NB_BYTES_PER_ROW,a1),a1
	lea		(BG_NB_BYTES_PER_ROW,a3),a3
	lea		(BG_NB_BYTES_PER_ROW,a4),a4
	.endm

* < A2: 6 plane pointers, A1/A3/A4: destinations (screen 1, screen 2, restore)
tile16_standard:
	moveq	#NB_BG_PLANES-1,d4
0:
	TILE16_NEXT_SOURCE
	TILE16_PLANE_COPY	0,BG_ROW_STRIDE
	TILE16_NEXT_DEST
	dbf		d4,0b
	rts

tile16_flipped:
	moveq	#NB_BG_PLANES-1,d4
0:
	TILE16_NEXT_SOURCE
	TILE16_PLANE_COPY	(BG_TILE_HEIGHT-1)*BG_ROW_STRIDE,-BG_ROW_STRIDE
	TILE16_NEXT_DEST
	dbf		d4,0b
	rts

tile16_mirror:
	moveq	#0,d2
	move.w	#BG_ROW_STRIDE,d3
	jra		tile16_mirror_any
tile16_mirror_flipped:
	move.w	#(BG_TILE_HEIGHT-1)*BG_ROW_STRIDE,d2
	move.w	#-BG_ROW_STRIDE,d3
* < D2: offset of the first row, D3: row step
tile16_mirror_any:
	move.l	a5,-(a7)
	lea		mirror_byte_table,a5
	moveq	#NB_BG_PLANES-1,d4
0:
	TILE16_NEXT_SOURCE
	move.w	d2,d1
	moveq	#BG_TILE_HEIGHT-1,d5
2:
	move.w	(a0)+,d6				| (d6 free: wrap flag already tested by update_bg_tile)
	MIRROR_WORD	a5
	move.w	d0,(a1,d1.w)
	move.w	d0,(a3,d1.w)
	move.w	d0,(a4,d1.w)
	add.w	d3,d1
	dbf		d5,2b
	TILE16_NEXT_DEST
	dbf		d4,0b
	move.l	(a7)+,a5
	rts

*****************************************************************
* blitter chain
*
* the chain is fed from 2 lists:
* - erase entries of the target buffer (1 blit each: restore => screen)
* - draw jobs (6 cookie-cut blits each), appended while the chain runs
* registers that don't change between blits of a job are written once
*****************************************************************

* starts the chain (blitter must be idle)
* < A5: custom
* trashes: D0-D1/A0-A1
kick_chain:
	st.b	c_busy
	jbsr	next_blit
	tst.w	d0
	jne		0f
	sf.b	c_busy
0:
	rts

* issues the next blit. Chain state is updated BEFORE bltsize is written
* so the interrupt of a very short blit always sees a consistent state
* < A5: custom
* > D0: 0 if there was nothing to do
* trashes: D1/A0-A1
next_blit:
	move.l	c_erase_ptr,a0
0:
	cmp.l	c_erase_end,a0
	jcc		10f
	move.w	(ER_SIZE,a0),d1
	jne		1f
	lea		(ER_SIZEOF,a0),a0		| static object: skipped
	jra		0b
1:
	move.l	(ER_OFFSET,a0),d0
	move.l	c_restore_base,a1
	add.l	d0,a1
	move.l	a1,(bltapt,a5)
	move.l	c_dest_base,a1
	add.l	d0,a1
	move.l	a1,(bltdpt,a5)
	move.w	(ER_MOD,a0),d0
	move.w	d0,(bltamod,a5)
	move.w	d0,(bltdmod,a5)
	lea		(ER_SIZEOF,a0),a0
	move.l	a0,c_erase_ptr
	move.w	d1,(bltsize,a5)
	moveq	#1,d0
	rts
10:
	move.l	a0,c_erase_ptr
	* draw jobs
	move.l	c_job_ptr,a0
	cmp.l	c_job_end,a0
	jcc		20f						| no job available (yet)
	move.w	c_plane,d1				| 0,4,...,20
	jne		11f
	* first plane of a job: registers common to the 6 blits
	move.w	(JOB_CON1,a0),(bltcon1,a5)
	move.w	(JOB_ABMOD,a0),d0
	move.w	d0,(bltamod,a5)
	move.w	d0,(bltbmod,a5)
	move.w	(JOB_CDMOD,a0),d0
	move.w	d0,(bltcmod,a5)
	move.w	d0,(bltdmod,a5)
	move.w	(JOB_ALWM,a0),(bltalwm,a5)
	move.l	(JOB_DEST,a0),c_plane_dest
11:
	move.l	c_plane_dest,a1
	move.l	a1,(bltcpt,a5)
	move.l	a1,(bltdpt,a5)
	lea		(BG_NB_BYTES_PER_ROW,a1),a1	| interleaved: next plane = next 32 bytes
	move.l	a1,c_plane_dest
	move.l	(JOB_MASK,a0),(bltapt,a5)
	move.l	(JOB_PLANES,a0,d1.w),d0
	jeq		12f
	move.l	d0,(bltbpt,a5)
	move.w	(JOB_CON0,a0),(bltcon0,a5)
	jra		13f
12:
	* empty plane: clear the plane under the mask, D = /A.C
	* minterm 0x0A doesn't involve B at all: no BLTBDAT, and the B shift
	* (BSH, set for the whole job) can't shift stale B data in
	move.w	(JOB_CON0,a0),d0
	and.w	#0xF000,d0				| keep A shift
	or.w	#0x0B0A,d0				| A,C,D, D = /A.C
	move.w	d0,(bltcon0,a5)
13:
	move.w	(JOB_SIZE,a0),d0
	addq.w	#4,d1
	cmp.w	#NB_PLAYFIELD_PLANES*4,d1
	jne		14f
	moveq	#0,d1
	lea		(JOB_SIZEOF,a0),a0
	move.l	a0,c_job_ptr
14:
	move.w	d1,c_plane
	move.w	d0,(bltsize,a5)
	moveq	#1,d0
	rts
20:
	moveq	#0,d0
	rts

*****************************************************************
* bob jobs
*****************************************************************

* arcade sprite list => jobs (+ erase entries for the target buffer)
* < A4: target buffer
* < A5: custom
build_bob_jobs:
	move.l	a6,-(a7)
	* same order as the arcade (last sprite drawn first)
	lea		buffered_spriteram+SPRITE_BUFFER_SIZE-CURRENT_SPRITE_SIZE,a2
1:
	jbsr	build_one_bob
	subq.w	#CURRENT_SPRITE_SIZE,a2
	cmp.l	#buffered_spriteram,a2
	jcc		1b
	move.l	(a7)+,a6
	rts

* < A2: sprite entry, A4: target buffer, A5: custom
* preserves A2/A4/A5
build_one_bob:
	tst.b	(TARGET_SPRITE_Y,a2)
	jeq		99f						| X follows Y: 0 means inactive
	moveq	#0,d0
	moveq	#0,d1
	move.b	(TARGET_SPRITE_X,a2),d1	| (screen is rotated: arcade X is host Y)
	move.b	(TARGET_SPRITE_Y,a2),d0
	moveq	#0,d2
	move.b	(TARGET_SPRITE_ATTRIBUTES,a2),d2
	btst	#0,d2
	jeq		0f
	sub.w	#0x100,d1
0:
	and.b	#0xC0,d2
	lsl.w	#2,d2
	move.b	(TARGET_SPRITE_CODE,a2),d2	| code = tile + bank*256
	neg.w	d1
	add.w	#0x100,d1
	cmp.w	#0x300,d2
	jcc		99f						| bank 3: not displayed
	cmp.w	#256-SPRITE_Y_CORRECTION,d1
	jcc		99f						| too low
	move.b	(TARGET_SPRITE_ATTRIBUTES,a2),d3
	move.w	d2,d6					| object code

	* manual horizontal grouping (see sprite_groups.68k):
	* 0: normal, bit 14: never drawn, else the code of the group bob
	* encoded *2+1, bit 10 flipped when mirrored: other half draws it
	lea		sprite_group_table,a3
	add.w	d2,d2
	move.w	(a3,d2.w),d4
	jeq		10f
	btst	#14,d4
	jne		99f
	bclr	#0,d4
	asr.w	#1,d4
	btst	#MIRROR_BIT,d3
	jeq		1f
	bchg	#10,d4
1:
	btst	#10,d4
	jne		99f
	move.w	d4,d2
	add.w	d2,d2
10:
	add.w	d2,d2
	lea		shared_bob_table,a3
	move.l	(a3,d2.w),d4
	jeq		99f
	move.l	d4,a3
	moveq	#0,d4
	move.b	d3,d4
	lsr.b	#4,d4
	and.w	#3,d4					| clut
	add.w	d4,d4
	add.w	d4,d4
	move.l	(a3,d4.w),d4
	jeq		99f						| clut not converted (transitions)
	move.l	d4,a3					| bob header
	tst.l	(BOB_MASK,a3)
	jeq		99f						| empty bob

	move.l	c_job_end,a1			| job being written (not visible to the chain yet)
	move.w	d6,(JOB_CODE,a1)
	move.w	(BOB_HEIGHT,a3),d4
	move.w	(BOB_WIDTH,a3),d5
	subq.w	#2,d5					| source bytes per row
	add.w	(BOB_YOFF,a3),d1

	* plane pointers
	btst	#MIRROR_BIT,d3
	jne		20f
	move.l	(BOB_MASK,a3),(JOB_MASK,a1)
	lea		(BOB_PLANES,a3),a0
	lea		(JOB_PLANES,a1),a3
	.rept	NB_PLAYFIELD_PLANES
	move.l	(a0)+,(a3)+
	.endr
	jra		30f
20:
	* mirrored: planes come from the mirror cache
	lea		(BOB_PLANES,a3),a3
	lea		(JOB_PLANES,a1),a6
	moveq	#NB_PLAYFIELD_PLANES-1,d7
21:
	move.l	(a3)+,d2
	jeq		22f
	move.l	d2,a0
	jbsr	mirror_plane
	move.l	a0,d2
22:
	move.l	d2,(a6)+
	dbf		d7,21b
	move.l	(a3),a0					| mask
	jbsr	mirror_plane
	move.l	a0,(JOB_MASK,a1)
30:
	* vertical position in the buffer, clipping
	add.w	game_scroll_y,d1		| bobs follow the scrolling
	add.w	#SPRITE_Y_CORRECTION,d1
	cmp.w	#BG_NB_LINES,d1
	jge		99f
	move.w	d1,d2
	add.w	d4,d2
	subq.w	#1,d2					| bottom line
	jmi		99f
	moveq	#0,d7					| clipped rows at the top
	tst.w	d1
	jpl		31f
	move.w	d1,d7
	neg.w	d7
	moveq	#0,d1
31:
	sub.w	d7,d4					| visible rows

	* horizontal position
	move.w	d0,d3
	and.w	#15,d3
	ror.w	#4,d3					| shift in bits 15-12
	move.w	d3,(JOB_CON1,a1)
	or.w	#0x0FCA,d3				| A,B,C,D, D = A.B + /A.C
	move.w	d3,(JOB_CON0,a1)
	lsr.w	#4,d0
	add.w	d0,d0					| first byte (even)
	move.w	d5,d6
	addq.w	#2,d6					| blit width in bytes
	* the shift column is read from the next row (modulo -2) and masked out
	move.w	#-2,(JOB_ABMOD,a1)
	clr.w	(JOB_ALWM,a1)
	move.w	d0,d3
	add.w	d6,d3
	cmp.w	#BG_NB_BYTES_PER_ROW+2,d3
	jls		32f
	* right clip: allow only the hidden first word of the next plane line
	moveq	#BG_NB_BYTES_PER_ROW+2,d6
	sub.w	d0,d6
	move.w	#-1,(JOB_ALWM,a1)
	move.w	d5,d3
	sub.w	d6,d3
	move.w	d3,(JOB_ABMOD,a1)
32:
	move.w	d4,d3
	lsl.w	#6,d3
	lsr.w	#1,d6
	or.w	d6,d3
	move.w	d3,(JOB_SIZE,a1)
	add.w	d6,d6

	* destination
	lea		mulLBG_ROW_STRIDE_table,a0
	move.w	d1,d3
	add.w	d3,d3
	add.w	d3,d3
	move.l	(a0,d3.w),d3
	add.l	d0,d3					| top-left visible byte (also used to erase)
	btst	#FLIP_BIT,(TARGET_SPRITE_ATTRIBUTES,a2)
	jne		33f
	mulu	d5,d7					| source offset: skip clipped rows
	move.l	d3,a3
	move.w	#BG_ROW_STRIDE,d2
	sub.w	d6,d2
	move.w	d2,(JOB_CDMOD,a1)
	jra		34f
33:
	* Y flip: draw from the bottom line upwards (clipped rows are the last source rows)
	moveq	#0,d7
	add.w	d2,d2
	add.w	d2,d2
	move.l	(a0,d2.w),a3
	add.w	d0,a3
	move.w	#-BG_ROW_STRIDE,d2
	sub.w	d6,d2
	move.w	d2,(JOB_CDMOD,a1)
34:
	add.l	c_dest_base,a3
	move.l	a3,(JOB_DEST,a1)
	tst.w	d7
	jeq		36f
	add.l	d7,(JOB_MASK,a1)
	lea		(JOB_PLANES,a1),a0
	moveq	#NB_PLAYFIELD_PLANES-1,d2
35:
	tst.l	(a0)
	jeq		351f
	add.l	d7,(a0)
351:
	addq.w	#4,a0
	dbf		d2,35b
36:
	* erase entry for the next time this buffer is drawn (1 interleaved blit)
	move.l	r_erase_wptr,a0
	move.l	d3,(ER_OFFSET,a0)
	mulu	#NB_PLAYFIELD_PLANES,d4
	lsl.w	#6,d4
	move.w	d6,d2
	lsr.w	#1,d2
	or.w	d2,d4
	move.w	d4,(ER_SIZE,a0)
	moveq	#BG_NB_BYTES_PER_ROW,d2
	sub.w	d6,d2
	move.w	d2,(ER_MOD,a0)
	move.w	(JOB_CODE,a1),(ER_CODE,a0)
	lea		(ER_SIZEOF,a0),a0
	move.l	a0,r_erase_wptr
	addq.w	#1,r_erase_count

	* publish the job, restart the chain if it ran out of work
	lea		(JOB_SIZEOF,a1),a1
	move.l	a1,c_job_end
	tst.b	c_busy
	jne		99f
	jbsr	kick_chain
99:
	rts

*****************************************************************
* mirrored planes cache
*
* the word before each bob plane (former "orientation" flag) holds a slot
* number. A slot is valid if <= slot count and its owner is that plane, so
* flushing the cache is just resetting the pool & count.
* Planes shared between cluts (masks...) are mirrored once.
*****************************************************************

* < A0: plane data (not null)
* < D4: rows, D5: bytes per row
* > A0: mirrored copy (original data if the cache is full)
* preserves everything else
mirror_plane:
	movem.l	d0-d3/d6/a1-a3,-(a7)
	moveq	#0,d0
	move.w	(-2,a0),d0
	jeq		10f
	cmp.w	r_mslot_count,d0
	jhi		10f
	lsl.w	#3,d0
	lea		mirror_slots-8,a1
	cmp.l	(a1,d0.w),a0
	jne		10f
	move.l	(4,a1,d0.w),a0			| hit
	jra		99f
10:
	* miss
	move.w	r_mslot_count,d0
	cmp.w	#MIRROR_MAX_SLOTS,d0
	jcc		99f
	move.w	d4,d1
	mulu	d5,d1
	move.l	r_mpool_ptr,a2
	lea		(a2,d1.l),a3
	cmp.l	#mirror_pool_end,a3
	jhi		99f
	move.l	a3,r_mpool_ptr
	addq.w	#1,d0
	move.w	d0,r_mslot_count
	move.w	d0,(-2,a0)
	lsl.w	#3,d0
	lea		mirror_slots-8,a1
	move.l	a0,(a1,d0.w)
	move.l	a2,(4,a1,d0.w)
	* mirror: word order reversed, bits reversed
	lea		mirror_byte_table,a1
	move.l	a2,a3
	move.w	d4,d3
	subq.w	#1,d3
	move.w	d5,d2
	lsr.w	#1,d2
	subq.w	#1,d2
20:
	add.w	d5,a2					| end of destination row
	move.w	d2,d1
21:
	move.w	(a0)+,d6
	MIRROR_WORD	a1
	move.w	d0,-(a2)
	dbf		d1,21b
	add.w	d5,a2					| next destination row
	dbf		d3,20b
	move.l	a3,a0
99:
	movem.l	(a7)+,d0-d3/d6/a1-a3
	rts
cache_fg_tiles_address:
	moveq	#0,d7
	lea		fg_tile_address_table,a0
0:
	jbsr	compute_fg_tile_xy

	move.b	d0,(a0)+		| store offset
	move.b	d1,(a0)+		| store offset

	addq.w	#1,d7
	cmp.w	#0x400,d7
	jne		0b
	rts


* < D7: 0-0x400
* > D0/D1: coords 
compute_fg_tile_xy:
	moveq	#0,d0
	move.b	d7,d0
	
	and.b	#0x1F,d0	| x
	neg.b	d0
	add.b	#0x1F,d0
	move.w	d7,d1
	lsr.w	#5,d1		| Y
	and.b	#0x1F,d1	| Y
	
	exg		d0,d1
	lsl.w	#3,d1		| times 8
	rts


	.macro	NEXT_SOURCE_PLANE
	move.l	(a4)+,d0		| next plane
	jne		5f
	move.l	#empty_row,d0
5:	
	move.l	d0,a0
	.endm

* < D7: 0-0x400 offset
* < D0: tile code
* < D1: tile attribute

update_fg_tile:
	* if < 0x40 bail out as not visible (same as in Ghosts'n'Goblins)
	cmp.w	#0x40,d7
	jcc		0f
	rts
0:

	moveq	#0,d2
	moveq	#0,d3
	move.b	d0,d2	| code
	move.b	d1,d3	| attribute + tile msbits (flip/mirror not used!)
	and.w	#0xC0,d3
	lsl.w	#2,d3
	add.w	d3,d2	| extended tile code
	move.b	d1,d3	| attribute + tile msbits
	and.w	#FG_TILE_NB_CLUTS-1,d3	| clut


	lea		fg_tile_address_table,a1
	.ifdef	NO68020
	add.w	d7,d7
	move.w	(a1,d7.w),d0
	.else
	move.w	(a1,d7.w*2),d0
	.endif
	moveq	#0,d1
	move.b	d0,d1
	lsr.w	#8,d0
	
	* select which destination sprites (0-3)
	move.w	d0,d4
	lea		hw_sprite_pointers,a1
	and.w	#0xF8,d4		| divide by 8
							| then multiply by 8 (sprite go by pairs)
	lea	(a1,d4.w),a1

	
	and.w	#0x7,d0		| dest X offset
	lsl.w	#4,d1		| dest Y offset (8*2 pixels per row)
	add.w	d0,d1
	add.w	#0x10,d1	| skip control word
	
	* get 2 pointers for 2 attached sprites
	move.l	(a1)+,a2
	move.l	(a1),a1
	

	exg		a1,a2
	* add offset to destination
	add.w	d1,a2
	add.w	d1,a1
	
	* now get source data
	lea		fg_character_table,a0
	

20:

	* updating bitplanes

	.ifdef	MC68020
	move.l	(a0,d2.l*4),d0		| tile pointer as LONG!
	.else
	add.w	d2,d2
	add.w	d2,d2	
	move.l	(a0,d2.l),d0		| tile pointer as LONG!
	.endif
	
	.ifdef	RELEASE
	jeq		11f 	| can happen when tile code is read when screen is being erased	
	.else
	jne		12f
	.ifndef	MC68020
	lsr.w	#2,d2
	.endif
	add.w	#FG_SCREEN_TILE_ADDRESS,d7
	*BREAKPOINT	"unregistered game tile (in D2, at address D7)"	

	jra		11f
	.endif
12:
	move.b	d3,d1
	lsr.b	#4,d1
	and.w	#3,d1		| mirror/flip
	
	and.w	#FG_TILE_NB_CLUTS-1,d3	| clut

	move.l	d0,a4
	.ifdef	MC68020
	move.l	(a4,d3.w*4),d0	| get proper clut
	.else
	add.w	d3,d3
	add.w	d3,d3	
	move.l	(a4,d3.w),d0	| get proper clut
	.endif
	jeq		11f
	
	
	move.l	d0,a4		| directly pointer on tile bitplanes
	

standard_tile8:
	* first plane: first sprite
	NEXT_SOURCE_PLANE
	.set	offset,0
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a1)
	.set	offset,offset+16
	.endr
	* second plane: first sprite, with a 8 offset
	NEXT_SOURCE_PLANE
	.set	offset,8
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a1)
	.set	offset,offset+16
	.endr
	* third plane: second sprite
	NEXT_SOURCE_PLANE
	.set	offset,0
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a2)
	.set	offset,offset+16
	.endr
	* second plane: second sprite, with a 8 offset
	NEXT_SOURCE_PLANE
	.set	offset,8
	.rept	8
	move.b	(a0)+,d0
	move.b	d0,(offset,a2)
	.set	offset,offset+16
	.endr

11:
	rts

empty_row:
	.skip	8
		
* < d0.w: x
* < d1.w: y
* < a1: sprite pos table (depending on height)
* > d0.L: control word
store_sprite_pos:
	tst.w	d1
	jmi	0f
	cmp.w	#256,d1
	jcc	0f

    move.l  a0,-(a7)

    lea	HW_SpriteXTable(pc),a0
	
	.ifndef	MC68020
    add.w	d0,d0
    add.w	d0,d0
    move.l	(a0,d0.w),d0
	move.w	d1,-(a7)
    add.w	d1,d1
    add.w	d1,d1
    or.l	(a1,d1.w),d0
	move.w	(a7)+,d1
	.else
    move.l	(a0,d0.w*4),d0
    or.l	(a1,d1.w*4),d0	
	.endc
    move.l  (a7)+,a0
    rts
0:
	moveq	#0,d0
	rts
	



HW_SpriteXTable:
	.set	reptn,0
	.rept 320
	.set	x,reptn+0x80
	.set reptn,reptn+1
    .byte  0,x>>1,0,x&1
  .endr

	.macro DEF_HW_SPRITE_Y_TABLE	height
HW_SpriteYTable_\height:
  .set	reptn,0
  .rept 288
	.set	ys,reptn+0x1c
	.set	ye,ys+\height
    .byte  ys&255, 0, ye&255, ((ys>>6)&4)+((ye>>7)&2)
	.set	reptn,reptn+1
  .endr
	.endm

	DEF_HW_SPRITE_Y_TABLE	256
scroll_table:
	* generated by python script
	.ifne	OPT_AGA_MODE
	.include	"scroll_table_64.68k"
	.else
	.include	"scroll_table_16.68k"
	.endif
	
object_type_table:
	.include	"object_type_table.68k"
	
	.include	"palette.68k"
osd_debug_hook:
	rts
	
	



	
* < D1: previous state
update_controls:
	moveq	#-1,d0

	lea		keyboard_table(pc),a0

	tst.b	(0x4C,a0)		| "up" key
	beq.b	0f
	bclr	#BIT_UP,d0
0:
	tst.b	(0x4D,a0)		| "down" key
	beq.b	0f
	bclr	#BIT_DOWN,d0
0:
	tst.b	(0x4F,a0)		| "<-" key
	beq.b	0f
	bclr	#BIT_LEFT,d0
0:
	tst.b	(0x4E,a0)		| "->" key
	beq.b	0f
	bclr	#BIT_RIGHT,d0
0:
	tst.b	(0x63,a0)		| "ctrl" key
	beq.b	0f
	bclr	#BIT_FIRE_1,d0
0:
	tst.b	(0x64,a0)		| left "alt" key
	beq.b	0f
	bclr	#BIT_FIRE_2,d0
0:

	* directions + fire
	move.l	joypad_1_state(pc),d1
	jbsr	decode_joypad_controls
	move.b	d0,(port_1_c001,a6)

	rts
	
decode_joypad_controls:
	btst	#JPB_BTN_UP,d1
	beq.b	0f
	bclr	#BIT_UP,d0
0:
	btst	#JPB_BTN_DOWN,d1
	beq.b	0f
	bclr	#BIT_DOWN,d0
0:
	btst	#JPB_BTN_LEFT,d1
	beq.b	0f
	bclr	#BIT_LEFT,d0
0:
	btst	#JPB_BTN_RIGHT,d1
	beq.b	0f
	bclr	#BIT_RIGHT,d0
0:
	btst	#JPB_BTN_RED,d1
	beq.b	0f
	bclr	#BIT_FIRE_1,d0
0:
	btst	#JPB_BTN_BLU,d1
	beq.b	0f
	bclr	#BIT_FIRE_2,d0
0:
	rts
	

	
read_system:
	st.b	d0
	movem.l	a0/d1,-(a7)
	lea		keyboard_table(pc),a0
	tst.b	coin1_requested
	jeq		0f
	subq.b	#1,coin1_requested
	st.b	detect_controllers
	bclr	#BIT_COIN1,d0
0:

	tst.b	coin2_requested
	beq.b	0f
	subq.b	#1,coin2_requested
	st.b	detect_controllers
	bclr	#BIT_COIN2,d0
0:	
	tst.b	(1,a0)		| "1" key like in MAME
	beq.b	0f
	st.b	detect_controllers
	bclr	#BIT_START_1P,d0
0:	
	tst.b	(2,a0)		| "2" key like in MAME
	beq.b	0f
	st.b	detect_controllers
	bclr	#BIT_START_2P,d0
0:	

	jbsr		is_game_playing
	jeq	1f
	move.l	joypad_1_state,d1

	* game not playing, we can insert coin/start with joypad
	btst	#JPB_BTN_RED,d1		| "5" key like in MAME
	jeq		0f
	st.b	detect_controllers
	bclr	#BIT_COIN1,d0
0:
	btst	#JPB_BTN_UP,d1		| "1" key like in MAME
	jeq		0f
	st.b	detect_controllers
	bclr	#BIT_START_1P,d0
0:
	btst	#JPB_BTN_DOWN,d1		| "2" key like in MAME
	jeq		0f
	st.b	detect_controllers
	bclr	#BIT_START_2P,d0
0:

1:	
	move.b	d0,(system_c000,a6)
	movem.l	(a7)+,a0/d1
	rts

	

	

level2_interrupt:
	jbsr		handle_keyboard
	move.w	#8,_custom+intreq
	rte
	
	
*TILE_GET_INFO_MEMBER(vball_state::get_bg_tile_info)
*{
*	uint8_t code = m_videoram[tile_index];
*	uint8_t attr = m_attribram[tile_index];
*	tileinfo.set(0,
*			code + ((attr & 0x1f) << 8) + (m_gfxset << 8),
*			(attr >> 5) & 0x7,
*			0);
*}


	.ifne	OPT_ENABLE_LOGGING
log_used_fg_tiles:
	* scan the whole screen, see what was updated
	* main screen

	GET_MEMORY_START_IN_A6
	lea		(FG_SCREEN_TILE_ADDRESS,a6),a5
	lea		(FG_SCREEN_COLOR_ADDRESS,a6),a4
	lea		fg_tile_log_table,a0
	move	#FG_TILE_NB_CLUTS-1,d4		| clut mask
	move	#FG_TILE_NB_CLUTS_POW,d5		| nb clut pow
	
	jra		log_any_tiles
	
log_used_bg_tiles:
	* scan the whole screen, see what was updated
	* main screen

	GET_MEMORY_START_IN_A6
	lea		(BG_SCREEN_TILE_ADDRESS,a6),a5
	lea		(BG_SCREEN_COLOR_ADDRESS,a6),a4
	lea		bg_tile_log_table,a0
	move	#BG_TILE_NB_CLUTS-1,d4		| clut mask
	move	#BG_TILE_NB_CLUTS_POW,d5		| nb clut pow

* both layers are of the same logical size
* fg layer is 256x256 with 8x8 tiles
* bg layer is 512x512 with 16x16 tiles

log_any_tiles:
	move.w	#0x400-1,d7
0:

	moveq	#0,d1
	moveq	#0,d0
	move.b	(a5,d7.w),d0	| tile code
	move.b	(a4,d7.w),d1	| tile attribute


	moveq	#0,d2
	moveq	#0,d3
	move.b	d0,d2	| code
	move.b	d1,d3	| attribute + tile msbits
	and.w	#0xC0,d3
	lsl.w	#2,d3
	add.w	d3,d2	| extended tile code
	move.b	d1,d3	| attribute + tile msbits
	and.w	d4,d3	| clut masked

	| remove flip/mirror
	lsl.l	d5,d2			| tile code * NB_CLUTS (long!)
	add.l	d3,d2			| add clut
	st.b	(a0,d2.l)
20:
	dbf		d7,0b
	rts
	
*	for (int offs = m_spriteram->bytes() - 4; offs >= 0; offs -= 4)
*	{
*		// bit 1 of attr is not used
*		int const attr = buffered_spriteram[offs + 1];
*		int const bank = (attr & 0xc0) >> 6;
*		int const code = buffered_spriteram[offs] + 256 * bank;
*		int const color = (attr & 0x30) >> 4;
*		int flipx = attr & 0x04;
*		int flipy = attr & 0x08;
*		int sx = buffered_spriteram[offs + 3] - ((attr & 0x01) << 8);
*		int sy = buffered_spriteram[offs + 2];
*
*		if (flip_screen())
*		{
*			sx = 240 - sx;
*			sy = 240 - sy;
*			flipx = !flipx;
*			flipy = !flipy;
*		}
*
*		if (bank < 3)
*			m_gfxdecode->gfx(2)->transpen(bitmap, cliprect, code, color, flipx, flipy, sx + 128, sy + 6, 15);
*	}

* sprite_log, log_sprites
log_used_sprites:

	* scan the whole screen, see what was updated
	* main screen
	
	GET_MEMORY_START_IN_A6
	lea		(SPRITE_ADDRESS,a6),a5
	lea	sprite_log_table,a0
	moveq	#0,d7
0:
	tst.w	(TARGET_SPRITE_Y,a5,d7.w)
	jeq		1f			| not active
	moveq	#0,d2
	moveq	#0,d1
	moveq	#0,d0
	move.b	(TARGET_SPRITE_CODE,a5,d7.w),d0
	move.b	(TARGET_SPRITE_ATTRIBUTES,a5,d7.w),d1
	move.b	d1,d2
	* extended tile code
	lsl.w	#2,d2
	and.w	#0x300,d2
	cmp.w	#0x300,d2
	jeq		1f				| bank 3: discard
	add.w	d2,d0
	lsr.b	#4,d1
	and.w	#SPRITE_NB_CLUTS-1,d1	| color
	
	lsl.l	#SPRITE_NB_CLUTS_POW,d0			| sprite code * NB_CLUTS (long!)
	add.l	d1,d0			| add clut

	st.b	(a0,d0.l)
1:
	addq	#TARGET_SPRITE_SIZEOF,d7
	cmp.w	#NB_TARGET_SPRITES*TARGET_SPRITE_SIZEOF,d7
	jne		0b
	rts
	.endif
	
	.macro	SATURATE_Y	val
	cmp.w	#\val+1,d0
	jcc		0f
	move.w	#\val,d0
	jra		1f
0:
	.endm
	
skip_level:
	movem.l	d0-a6,-(a7)
	
	clr.w	tune_index_times_8
	
	GET_MEMORY_START_IN_A6
	lea	(global_y_lsb_eda2,a6),a0
	move.b	(1,a0),d0
	lsl.w	#8,d0
	move.b	(a0),d0
	bclr	#14,d0
	sne		d1		| second loop
	
	SATURATE_Y	0x700
	SATURATE_Y	0xF00
	SATURATE_Y	0x1700
	SATURATE_Y	0x1F00
1:
	move.b	#5,(game_state_e001,a6)		| state: level completed
	tst.b	d1
	jeq		2f
	bset	#14,d0	| restore second loop bit
2:
	move.b	d0,(a0)+
	lsr.w	#8,d0
	move.b	d0,(a0)
	movem.l	(a7)+,d0-a6
	rts
	
warp_on_top_of_screen:
	movem.l	d0-a6,-(a7)
	GET_MEMORY_START_IN_A6

	movem.l	(a7)+,d0-a6
	rts
	
handle_keyboard:
	movem.l	D0/A0/A5,-(a7)
	LEA	0x00BFD000,A5
	MOVEQ	#0x08,D0
	AND.B	0x1D01(A5),D0
	jeq		1f
	MOVE.B	0x1C01(A5),D0
	NOT.B	D0
	ROR.B	#1,D0		| raw key code here
  
	CLR.B	0x1C01(A5)
  
    lea keyboard_table(pc),a0
    bclr    #7,d0
    seq (a0,d0.w)       | updates keyboard table
    jne   2f     | we don't care about key release
	
	* to insert a credit, game needs a short pulse
	* so maintaining the key too long would fail. But too
	* short would not work either. 10 ticks seems to work
	cmp.b	#5,d0	| "5" key like in MAME
	bne.b	0f
	move.b	#10,coin1_requested
0:
	cmp.b	#6,d0	| "5" key like in MAME
	bne.b	0f
	move.b	#10,coin2_requested
0:

    cmp.b   #0x19,d0	| "P" key
    bne.b   0f

    bsr	toggle_pause
0:

	* last life, time=0, direct game over
	cmp.b	#69,d0	| ECS key: kill+1 life
	bne.b	0f
	jbsr	lose_all_lives
0:


	* cheat keys are always active in dev mode
	.ifdef	RELEASE
	btst	#4,cheat_flags+3
	jeq		10f
	.endif
	* cheat keys


	cmp.b	#0x50,d0	| F1 key: toggle invincible
	bne.b	0f
	st.b	cheat_used
	not.b	invincible_flag
	COLOR0_FLASH	0x0FF
	
0:
	cmp.b	#0x51,d0	| F2 key: skip level
	bne.b	0f
	st.b	cheat_used
	jbsr	skip_level
	COLOR0_FLASH	0x0FF
	
0:
	cmp.b	#0x52,d0	| F3 key: change weapon
	bne.b	0f
	st.b	cheat_used

	
0:

	cmp.b	#0x53,d0	| F4 key: warp on top of scren
	bne.b	0f
	st.b	cheat_used
	COLOR0_FLASH	0x0FF
0:
	cmp.b	#0x54,d0	| F5 key
	bne.b	0f
	st.b	cheat_used
	COLOR0_FLASH	0x0FF
	jbsr	add_to_score
0:

10:
	.ifndef	RELEASE
	cmp.b	#34,d0
	bne		0f
	* 'D': dump all logging buffers to data dir
	jbsr	osd_dump_logs
0:

	
	cmp.b	#0x55,d0	| F6 key: debug params
	bne.b	0f
	COLOR0_FLASH	0x0FF
0:
	cmp.b	#0x56,d0	| F7 key: debug params
	bne.b	0f
	eor.b		#1,osd_debug_active
0:
	cmp.b	#0x58,d0	| F9 key crashes game (restarts whdload)
	bne.b	0f
	illegal
0:

	.endif

	cmp.b	_keyexit,d0	| "ESC" key or whdload quitkey
	bne.b	2f
	BSET	#0x06,0x1E01(A5)
	moveq	#2,d0
	bsr	beamdelay
	BCLR	#0x06,0x1E01(A5)	| acknowledge key
	bra		quit_to_os
2:
	BSET	#0x06,0x1E01(A5)
	moveq	#2,d0
	bsr	beamdelay
	BCLR	#0x06,0x1E01(A5)	| acknowledge key

1:
	movem.l	(a7)+,d0/a0/a5
	rts
	
toggle_pause:
	* pause only within game (or in dev mode)
	.ifdef	RELEASE
	jbsr		is_game_playing
	jne	0f
	.endif
	eor.b   #1,pause_flag
0:
	rts

	

    
* < D0: numbers of vertical positions to wait
beamdelay:
0:
	move.w  d0,-(a7)
    move.b	0xdff006,d0	| VPOS
1:
	cmp.b	0xdff006,d0
	beq.s	1b
	move.w	(a7)+,d0
	dbf	d0,0b
	rts

	
	MUL_TABLE	BG_NB_BYTES_PER_ROW,BG_NB_LINES
	MUL_TABLE	FG_NB_BYTES_PER_ROW,FG_NB_LINES

	.align	4		| leave this long word alignment
program_args:	ds.l	64,0
program_args_end:
	.long	0		| add a longword else it overwrites the read args string in kick 1.3!
	.align	4
read_args_string:
	.byte	read_args_string_end-read_args_string
	.ascii	"INVINCIBLE/S,INFLIVES/S,CHEATKEYS/S,50HZ/S,NOLONGPRESS/S"
read_args_string_end:
	.align	2


osd_read_high_scores:
	OSD_ENTER
	movem.l	d0-d7/a0-a6,-(a7)
	move.l	_resload,d0
	beq.b	0f
	move.l	d0,a2
	move.l	a0,a1
	bsr		get_hiscore_name
	move.l	a1,-(a7)
 	jsr		resload_GetFileSize(a2)		
	move.l	(a7)+,a1
	tst.l	d0
	beq.b	1f
	bsr		get_hiscore_name
	jsr		resload_LoadFile(a2)	
	bra.b	1f
0:
	tst.b	highscore_loaded
	beq.b	1f

	* from DOS: just copy buffer
	lea		high_score_buffer,a1
	move.w	#SCORE_FILE_SIZE-1,d0
0:
	move.b	(a1)+,(a0)+
	dbf		d0,0b
1:
	movem.l	(a7)+,d0-d7/a0-a6
	OSD_EXIT
	rts
	
*	GET_MEMORY_START_IN_A6
*	move.l	a0,a6
*	add.l	#hi_score_1st_ee00,a0
	
* < A0: highscore buffer
osd_write_high_scores:
	OSD_ENTER
	movem.l	d0-d7/a0-a6,-(a7)
	.ifdef	RELEASE
	tst.b	cheat_used		| don't save score if cheat on
	bne.b	2f
	.endif
	
	move.l	_resload,d0
	bne.b	1f
	* DOS
	* first just copy buffer as contiguous 
	lea		high_score_buffer,a1
	move.w	#SCORE_FILE_SIZE-1,d0
0:
	move.b	(a0)+,(a1)+
	dbf		d0,0b
	st.b	highscore_needs_saving
	jra		2f
1:
	* whdload
	move.l	a0,a1
	move.l	d0,a2
	move.l	#SCORE_FILE_SIZE,d0
	bsr		get_hiscore_name
	jsr		resload_SaveFile(a2)
2:

	movem.l	(a7)+,d0-d7/a0-a6
	OSD_EXIT
	rts

	
get_hiscore_name:
    lea normal_hiscorename,a0
	rts
	
load_highscores:
    move.l  _resload,d0
    bne.b   1f

	bsr.b		get_hiscore_name
    move.l  _dosbase,a6
    move.l  a0,d1
    move.l  #1005,d2
    jsr     (_LVOOpen,a6)
    move.l  d0,d1
    beq.b   1f
    move.l  d1,d4
    move.l  #SCORE_FILE_SIZE,d3
    move.l  #high_score_buffer,d2
    jsr (_LVORead,a6)
    move.l  d4,d1
    jsr (_LVOClose,a6)   
	st.b	highscore_loaded
1:

    rts

save_highscores:
	tst.l	_resload
	bne.b	1f
    tst.b   highscore_needs_saving
    beq.b   1f
    move.l  _dosbase,a6
	bsr.b		get_hiscore_name
    move.l  a0,d1
    move.l  #1006,d2
    jsr     (_LVOOpen,a6)
    move.l  d0,d1
    beq.b   1f
    move.l  d1,d4
    move.l  #SCORE_FILE_SIZE,d3
    move.l  #high_score_buffer,d2
    jsr (_LVOWrite,a6)
    move.l  d4,d1
    jsr (_LVOClose,a6)   
1:	
    rts
    
	
osd_music_stop:
*	movem.l	d0/a0/a6,-(a7)
*	lea		_custom,a6
*	move.w	#3,d0
*	jbsr	_mt_stopfx
*	movem.l	(a7)+,d0/a0/a6

	
	tst.b	music_playing
	jne		force_sound_stop
	rts
	


force_sound_stop:
	OSD_ENTER
	movem.l	d0-d1/a0/a6,-(a7)
	lea		_custom,a6
	move.b	#-1,music_track_start_number
    clr.w   music_tick   | not playing anymore
	clr.b	music_playing
	clr.l	looped_sound_enabled

	clr.w	tune_index_times_8
    jsr		_mt_end

	movem.l	(a7)+,d0-d1/a0/a6
	OSD_EXIT
	rts
	
* < D0.B sound index
osd_sound_start:
	OSD_ENTER
	movem.l	d0/d1/d2/a0/a1/a6,-(a7)

	and.w	#0xFF,d0

	cmp.b	#LEVEL_COMPLETED_TUNE_SND,d0
	jne		0f
	* if last level, set a timer to cut the music in the middle
	move.w	(global_y_lsb_eda2,a6),d1
	cmp.w	#0x001F,d1		| last boss defeated
	jne		0f
	* last boss: must cut the music
	move.w	#300-0x80,end_level_timer
0:

	cmp.b	#LEVEL_TUNE_SND,d0
	jeq		1f
	cmp.w	#LAST_LEVEL_RESUME_TUNE_SND,d0
	jne		0f
	* last level sound queued after intro: we start a timer to play
	* that tune after a while
	move.w	#170-0x1C,main_bgm_timer	
0:
	cmp.b	#LAST_LEVEL_TUNE_SND,d0
	jne		0f
1:
	* don't play level BGM if intro music playing
	* (like GnG the game queues both tunes and the
	* sound CPU chains them)
	move.w	tune_index_times_8,d1
	cmp.w	#LEVEL_START_TUNE_SND*8,d1
	jeq		10f
	cmp.w	#LEVEL_RESUME_TUNE_SND*8,d1
	jeq		10f

0:	
	moveq	#0,d2
	lsl.w	#3,d0
	lea		sound_table,a0


	move.w	(a0,d0.w),d1	| sound type
	jeq	11f		| no sound
	cmp.w	#3,d1
	jeq	10f			| mute for now
2:
	cmp.w	#1,d1
	jne	4f		| music module
	* normal sample
	move.w	(2,a0,d0.w),d1
	move.l	(4,a0,d0.w),a0
	lea		_custom,a6
	tst		d1
	jeq	3f
	
	* looped sound
	moveq	#0,d0
	move.b	(10,a0),d0		| channel

	lea		looped_sound_enabled,a1
	
	* sound stop
	clr.b	(a1,d0.w)
	movem.l	d0/a0,-(a7)
	jbsr	_mt_stopfx
	movem.l	(a7)+,d0/a0
	tst.b	d2
	jne		10f		| sound stop requested: done
2:
	* now that prev loop is stopped, play the next one
	st.b	(a1,d0.w)
	jbsr		_mt_loopfx
	jra	10f
3:
	jbsr		_mt_playfx
10:
	movem.l	(a7)+,d0/d1/d2/a0/a1/a6
	OSD_EXIT
	rts
11:
	.ifndef	RELEASE
	lsr.w	#3,d0
	move.w	d0,d2
	BREAKPOINT	"unknown sound (in d2)"
	.endif
	jra		10b
12:
	* stop all sounds
	jbsr	_mt_end
	jra		10b
	
	* music
4:

	* don't play if already playing
	* (music_tick value is not important for looped tunes
	* as long as it's not zero)


	* here we allow music to override another looping music
	*tst.w	music_tick
	*bne.b	10b
	* play the proper module pattern
	* load up the countdown if loop
		

    movem.l d0-a6,-(a7)
    lea _custom,a6
	
	
 	movem.l	d0/a0,-(a7)
	
	move.w	d0,tune_index_times_8		| note down current tune index
	
	move.w	(2,a0,d0.w),d1	| pattern number in .mod file
	lea		commando_tunes,a0
	
	moveq	#0,d0
	move.w	d1,d0
    sub.l   a1,a1		| samples are in the module
    jsr _mt_init
	movem.l	(a7)+,d0/a0

    * set master volume a little less loud if needed
	move.b	(6,a0,d0.w),music_volume


	st.b	music_playing

    moveq	#0,d0
	move.b	music_volume,d0
    jsr	_mt_mastervol
    jsr _mt_start
60:
    movem.l (a7)+,d0-a6
	
6:
	jra	10b
no_tune:
	movem.l	(a7)+,d0/a0
	jra		5b
	

	
* all level modules have the same structure but in fact not atm...
* 0-9              stage music + boss
* 10               empty block in loop      
* 11               low time                 
* 12               death                    
* 13               MAP                     
* 14-15          game over                
* 16-17          Key         
* 
* (only last boss mod)             
* 16                bad ending
* 17-22           good ending
	

quit_to_os:
	tst.l	_resload
	bne.b	0f
	jbsr		restore_system
	* set SR to 0 from here, so we return to OS with SR=0
	* (else it kills the system pretty quickly)
	* it works as quit_to_os is called from an interrupt
	move.w	#0,SR
	move.l	old_stack,a7
	*jbsr		save_highscores
	moveq	#0,d0
	rts
0:
	pea	  TDREASON_OK
	move.l	_resload,-(a7)
	addq.l	#resload_Abort,(a7)
	rts




* < A0: filename
* > D0: size (decrunch supported)
get_file_size:
	tst.l	_resload
	jeq		0f
	movem.l	d1/a0-a2,-(a7)
	move.l	_resload,a2
	jbsr	(resload_GetFileSizeDec,a2)
	movem.l	(a7)+,d1/a0-a2
	rts
0:
	* unsupported
	BREAKPOINT	"non-whdload mode unsupported"
	rts



