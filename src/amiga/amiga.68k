	.else
OPT_AGA_MODE=0
	.endif

FG_TILE_HEIGHT = 8
BG_TILE_HEIGHT = 16

* a plane of attached sprites	
NB_FG_PLANES = 4
NB_BG_PLANES = NB_PLAYFIELD_PLANES

TOTAL_NB_COLORS = 1<<NB_PLAYFIELD_PLANES
FG_NB_BYTES_PER_ROW = 0x20
BG_NB_BYTES_PER_ROW = 0x20

Y_START = 0x20

	.if	NB_PLAYFIELD_PLANES == 6
BASE_BPLCON2_VALUE = 0x0264			| killehb (we're using 6 real bitplanes) sprites above all playfields
	.else
BASE_BPLCON2_VALUE = 0x0064
	.endif

BASE_BPLCON4_VALUE = 0x0044	  | sprites palette starts at color 64

FG_NB_LINES = 256
BG_NB_LINES = 512+256
Y_MAX = 512+256
NB_PLAYFIELD_LINES = BG_NB_LINES


BG_SCREEN_PLANE_SIZE = BG_NB_BYTES_PER_ROW*BG_NB_LINES

BG_SCREEN_SIZE = BG_SCREEN_PLANE_SIZE*NB_PLAYFIELD_PLANES

NB_HOST_SPRITES = 8

NB_TARGET_SPRITES = 96


******************************************************************
* renderer (2026-10 rewrite)
*
* - screens are INTERLEAVED (one line = 6 plane lines of 32 bytes)
*   so erasing a bob is a single blit (restore buffer => screen)
* - drawing a bob is 6 cookie-cut blits (sprite planes aren't interleaved
*   in the assets and there's no chip RAM left to convert them)
* - blits are issued by the blitter interrupt from compact per-bob jobs,
*   while the CPU runs the game (no blitter waits anywhere)
* - mirrored sprites come from a cache of mirrored planes (no in-place
*   flipping, so soldiers facing both ways cost nothing after 1st use)
* - background tiles written by the game are queued and drawn by the
*   VBL interrupt when the blitter is idle, nearest-to-screen first
******************************************************************

BG_ROW_STRIDE = BG_NB_BYTES_PER_ROW*NB_PLAYFIELD_PLANES	| 192 bytes: one interleaved line
BUFFER_MARGIN_LINES = 48					| bobs can go below the 768 lines
BG_BUFFER_LINES = BG_NB_LINES+BUFFER_MARGIN_LINES
BG_BUFFER_SIZE = BG_ROW_STRIDE*BG_BUFFER_LINES
WRAP_COPY_OFFSET = BG_ROW_STRIDE*512			| rows 0-15 are drawn twice (display wraps)

* bob header (from convert_graphics.py)
BOB_HEIGHT = 0
BOB_WIDTH = 2			| bytes, includes the 16-bit shift column (not stored)
BOB_YOFF = 4
BOB_PLANES = 8			| 6 plane pointers (0: empty plane)
BOB_MASK = BOB_PLANES+NB_PLAYFIELD_PLANES*4

* blitter job: one per bob, expanded into 6 blits by the blitter interrupt
JOB_DEST = 0			| .l plane 0 destination (bottom line if Y-flipped)
JOB_MASK = 4			| .l mask (A)
JOB_PLANES = 8			| 6 .l planes (B), 0 = empty plane (B disabled)
JOB_CON0 = JOB_PLANES+NB_PLAYFIELD_PLANES*4
JOB_CON1 = JOB_CON0+2
JOB_ABMOD = JOB_CON0+4
JOB_CDMOD = JOB_CON0+6
JOB_ALWM = JOB_CON0+8
JOB_SIZE = JOB_CON0+10
JOB_CODE = JOB_CON0+12	| object code (for static objects)
JOB_SIZEOF = JOB_CON0+16
MAX_JOBS = NB_TARGET_SPRITES

* erase entry: one per drawn bob, per buffer, consumed the next time this buffer is drawn
ER_OFFSET = 0			| .l offset in buffer (same in restore buffer)
ER_SIZE = 4				| .w bltsize, 0 = skip (static object)
ER_MOD = 6				| .w A & D modulo
ER_CODE = 8				| .w object code
ER_SIZEOF = 10

* per-buffer state
BUF_BASE = 0			| .l
BUF_SCROLL = 4			| .l game_scroll_x/game_scroll_y when last drawn
BUF_ERASE_CUR = 8		| .l erase list to process next time
BUF_ERASE_NEXT = 12		| .l erase list being filled
BUF_ERASE_COUNT = 16	| .w
BUF_SIZEOF = 20

* mirrored planes cache
MIRROR_POOL_SIZE = 0xA000
MIRROR_FRAME_NEED = 0x1800			| most bytes a single frame can add (see 0x14C in dev builds)
MIRROR_POOL_FLUSH = MIRROR_POOL_SIZE-MIRROR_FRAME_NEED	| flushed at frame start above that
MIRROR_MAX_SLOTS = MIRROR_POOL_SIZE/32

* reverses the 16 bits of a word with a 256-byte table (2 lookups)
* < D6: word, \table: address register on mirror_byte_table
* > D0: mirrored word. trashes D6
	.macro	MIRROR_WORD	table
	moveq	#0,d0
	move.b	d6,d0
	move.b	(\table,d0.w),d0		| reversed low byte...
	lsl.w	#8,d0					| ...becomes the high byte
	lsr.w	#8,d6
	move.b	(\table,d6.w),d0		| reversed high byte becomes the low byte
	.endm

* deferred background tiles
BG_TILE_QUEUE_SIZE = 0x800			| entries, power of 2, > 0x400
BG_TILE_QUEUE_MASK = BG_TILE_QUEUE_SIZE*2-1
BG_TILES_PER_FRAME = 4				| tiles drawn per VBL when none is close to the screen
BG_TILES_MAX_PER_FRAME = 16			| hard cap per VBL
BG_TILE_URGENT_MARGIN = 32			| lines around the visible window

	.macro	MUL_TABLE_L value,len
mulL\value\()_table:
	.set    mulv,0
	.rept	\len
	.long	mulv
	.set	mulv,mulv+\value
	.endr
	.endm

SPRITE_X = 2
SPRITE_Y = 3
SPRITE_CODE = 0
SPRITE_ATTRIBUTES = 1
SPRITE_SIZEOF = 4

BIT_COIN1 = 7
BIT_COIN2 = 6

BIT_START_1P = 0
BIT_START_2P = 1

BIT_UP = 3
BIT_RIGHT = 0
BIT_LEFT = 1
BIT_DOWN = 2
BIT_FIRE_1 = 4
BIT_FIRE_2 = 5

LONG_FIRE_TIMER_VALUE = 30
	
	.macro	COLOR0_FLASH	v
	.ifne	OPT_AGA_MODE
	move.w	#(BORDERBLANK<<5),_custom+bplcon3
	.endif
	move.w	#\v,_custom+color	
	.endm

	.macro	WRITE_TEXT	text,x_offset
	lea		\text,a1
	lea		(0x2047+\x_offset+0x20*row,a6),a0
	move.b	current_color,d0
	jbsr	display_text
	.set	row,row+1
	.endm

	.macro	WRITE_HEX	value
	move.w	\value,d1
	lea		(0x2047+0x20*row+14,a6),a0
	move.b	current_color,d0
	jbsr	display_number
	.set	row,row+1
	.endm
	
	* OSD ENTER/EXIT aren't useful for a Z80 game
	* as the code rarely uses the native stack to quick-read memory
	* (no multiple move like PULS/PSHS)
	
	.macro	OSD_ENTER
	.endm
	
	.macro	OSD_EXIT
	.endm
	
	

* exports

