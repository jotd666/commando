* bit-reversed bytes (was a 128 KB word table)
mirror_byte_table:
	.set	mbt_i,0
	.rept	256
	* no '|' here: it starts a comment on m68k gas (bits don't overlap, + is the same as or)
	.byte	((mbt_i&1)<<7)+((mbt_i&2)<<5)+((mbt_i&4)<<3)+((mbt_i&8)<<1)+((mbt_i&16)>>1)+((mbt_i&32)>>3)+((mbt_i&64)>>5)+((mbt_i&128)>>7)
	.set	mbt_i,mbt_i+1
	.endr
	.align	2

	.align 2

	.section 	.data
	.ifndef	RELEASE
interrupted_code_pc:
	.long	0
log_ptr:
	.long	log_buffer
cpu_log_enable:
	.word	0
cpu_log_prev_state:
	.word	0
osd_debug_active:
	.byte	0
	.endif

	.section	.bsspublic
buffered_spriteram:
	.skip SPRITE_BUFFER_SIZE
mirror_buffer_ptr:
	.long	0
mirror_buffer_context_ptr:
	.long	0
context_sprite_table_ptr:
	.long	0

	
fg_tile_address_table:
	.skip	0x400*2

bg_tile_address_table:
	.skip	0x400*2

	
	.ifne	OPT_ENABLE_LOGGING
log_buffer:
	.skip	LOG_BUFFER_SIZE
log_buffer_end:
	.skip	16

fg_tile_log_table:
	* a lot of combinations aren't used (fortunately!)
	.skip	FG_TILE_LOG_LENGTH
fg_tile_log_table_end:
bg_tile_log_table:
	* a lot of combinations aren't used (fortunately!)
	.skip	BG_TILE_LOG_LENGTH
bg_tile_log_table_end:

sprite_log_table:
	* a lot of combinations aren't used (fortunately!)
	.skip	SPRITE_LOG_LENGTH
sprite_log_table_end:
	.endif
	


r_jobs:
	.skip	MAX_JOBS*JOB_SIZEOF
erase_list_0a:
	.skip	MAX_JOBS*ER_SIZEOF
erase_list_0b:
	.skip	MAX_JOBS*ER_SIZEOF
erase_list_1a:
	.skip	MAX_JOBS*ER_SIZEOF
erase_list_1b:
	.skip	MAX_JOBS*ER_SIZEOF
	.align	4
mirror_slots:
	.skip	MIRROR_MAX_SLOTS*8
bg_tile_queue:
	.skip	BG_TILE_QUEUE_SIZE*2
bg_tile_pending_flags:
	.skip	0x400
bg_tile_last_index:
	.skip	0x400*2

	.section	.datachip


	
	.macro	DECL_BITPLANES	bpoff_start,nb_planes
	.set	bpoff,\bpoff_start
	.rept	\nb_planes
	dc.w  0xe0+bpoff,0
	dc.w  0xe2+bpoff,0
	.set	bpoff,bpoff+4
	.endr
	.endm
	
	.macro	DECL_COLORS	offset,nb_colors
	.set	colidx,\offset
	.rept	\nb_colors
	dc.w	color+(colidx*2),0
	.set	colidx,colidx+1
	.endr
	.endm

	.macro	DECL_SPRITES
	.set	sprite_start,sprpt+0
	.rept	16
	* 2 slots
	.word	sprite_start,0
	.set	sprite_start,sprite_start+2
    .endr
	.endm

	.macro	DECL_32_COLORS
	DECL_COLORS	0,32
	.endm

	.macro	DECL_ROW
	.word   0x01+(y_pos<<8),0xFFFE
	.word   cop2lc,0        | jump high
	.word   cop2lc+2,0      | jump low
	.word   copjmp2,0
	DECL_BITPLANES	0,NB_PLAYFIELD_PLANES	
	.set	y_pos,y_pos+1
	.endm
	
	
blank_sprite:
	.long	0,0
	
blank_sound:
	ds.l	4
	
debug_copperlist:
	dc.w	bplcon0,0x200
	dc.w	color
debug_color:
	dc.w	0
	dc.l	-2
	


	
	* main copperlist
game_copperlist:
	* all sprites have the same palette no need to specify odd or even
	
	* black color background plane
	* enable sprite colors now
	.word	0x0601,0xFFFE
	
		

	
game_sprites:
	DECL_SPRITES
game_sprites_end:

copperlist_colors:
	.ifeq	OPT_AGA_MODE
	DECL_32_COLORS
	.else
	.set	bpl_count,0
	.rept	NB_PLAYFIELD_PLANES+1		| one more bank for sprites
	.word	bplcon3,(bpl_count<<13)+(BORDERBLANK<<5)
	.set	bpl_count,bpl_count+1
	DECL_32_COLORS
	.endr
	.endif

screen_start:
	.word	0x01+(0x20<<8),0xFFFE
bobs_bitplanes:
	DECL_BITPLANES	0,NB_PLAYFIELD_PLANES

	.word	bplcon1
fine_x_scroll_value:
	.word	0
	* here was first_rows (before I disabled it)
	* mid-line wait & extra interrupt
	.word	0x8001,0xFFFE
pal_intreq_block_game:
	.word	 intreq,0x8014  | call level 1 interrupt in the middle of a frame, also flag so copper interrupt knows that we're going to call copper int
	* here was second_rows (before I disabled it)
	
	
	* pal limit
	.if		OPT_AGA_MODE
    .word  0xFFCF,0xFFFE       | PAL wait 128 colors needs FFCF, FFDF fails
	.else
    .word  0xFFDF,0xFFFE       | PAL wait
	.endif
	* we have to perform several small waits else it doesn't wait
	* I don't want to know why, it works.
pal_wait:

	.word	0x01+(0x04<<8),0xFFFE
	.word	0x01+(0x0C<<8),0xFFFE
	.word	0x01+(0x30<<8),0xFFFE


	
	.word	 intreq,0x8004



     .long    -2					
	.ascii	"ENDCPLST"
	

	
	* aligning on 8 bytes so .align will work
	* in the next datachip sections
	.section .bsschip

hw_sprite_ram_buffer:
	.skip	HW_SPRITE_BUFFER_SIZE*8	| 8 64-bit wide sprites + control words + align

* +16: alignment slack (see platform_init)
restore_buffer:
	.skip	BG_BUFFER_SIZE+16
screen_buffer_1:
	.skip	BG_BUFFER_SIZE+16
screen_buffer_2:
	.skip	BG_BUFFER_SIZE+16
* mirrored bob planes, read by the blitter
mirror_pool:
	.skip	MIRROR_POOL_SIZE
mirror_pool_end:
chipmem_end:
	.skip	8
